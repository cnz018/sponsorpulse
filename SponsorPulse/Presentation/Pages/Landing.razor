                        <li><a href="#" class="hover:text-[#CCC9DC] transition-colors">Confidentialité</a></li>
                        <li><a href="#" class="hover:text-[#CCC9DC] transition-colors">Cookies</a></li>
                    </ul>
                </div>*@
                            </div>

                            <!-- Divider -->
                            <div class="border-t border-white/10 pt-8">
                                <div class="flex flex-col md:flex-row justify-between items-center text-sm text-[#94A3B8]">
                                    <p>&copy; 2026 SponsorPulse. Tous droits réservés.</p>
                                    <div class="flex gap-4 mt-4 md:mt-0">
                                        <LumexPopover Placement="@PopoverPlacement.Top" Offset="8" ShowArrow="@true">
