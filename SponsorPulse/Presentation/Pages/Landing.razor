@code {
    private bool isLoading = false;

    // Mobile menu state
    private bool isMobileMenuOpen = false;

    // Waitlist fields
    private string waitlistEmail = "";
    private bool waitlistSubmitted = false;
    private bool waitlistLoading = false;
    private string? waitlistError;
    private int waitlistCount = 0;

    [Inject]
    private IWaitlistService WaitlistService { get; set; } = default!;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
        StateHasChanged();
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // Initialiser le compteur depuis le service
        waitlistCount = WaitlistService.GetWaitlistCount();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Add scroll event listener for navbar background
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    const navbar = document.querySelector('.landing-navbar');
                    if (navbar) {
                        const handleScroll = () => {
                            if (window.scrollY > 50) {
                                navbar.classList.add('sticky-active');
                            } else {
                                navbar.classList.remove('sticky-active');
                            }
                        };
                        window.addEventListener('scroll', handleScroll);
                        // Check initial scroll position
                        handleScroll();
                    }
                })()
            ");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task SubmitWaitlist()
    {
        waitlistError = null;

        // Validation
        if (string.IsNullOrWhiteSpace(waitlistEmail))
        {
            waitlistError = "Veuillez entrer votre email";
            return;
        }

        if (!waitlistEmail.Contains("@") || !waitlistEmail.Contains("."))
        {
            waitlistError = "Veuillez entrer un email valide";
            return;
        }

        waitlistLoading = true;
        StateHasChanged();

        try
        {
            // Appel API avec URL absolue pour éviter les problèmes de BaseAddress
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var requestUri = $"{baseUri}/api/waitlist";

            Logger.LogInformation("Envoi requête waitlist à: {Uri}", requestUri);

            using var httpClient = new HttpClient();
            var response = await httpClient.PostAsJsonAsync(requestUri, new { Email = waitlistEmail });

            if (response.IsSuccessStatusCode)
            {
                waitlistSubmitted = true;
                waitlistEmail = "";

                // Incrémenter le compteur localement
                waitlistCount++;
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Erreur API waitlist: {Status} - {Content}", response.StatusCode, content);
                waitlistError = "Une erreur est survenue. Réessayez plus tard.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception waitlist: {Message}", ex.Message);
            Console.WriteLine($"Erreur waitlist: {ex.Message}");
            waitlistError = "Une erreur est survenue. Réessayez plus tard.";
        }
        finally
        {
            waitlistLoading = false;
        }
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !waitlistLoading)
        {
            await SubmitWaitlist();
        }
    }

    private double GetProgressPercentage()
    {
        // Progress bar vers 1000 inscrits (ajuster selon objectif)
        var target = 1000;
        var percentage = (double)waitlistCount / target * 100;
        return Math.Min(percentage, 100);
    }

    private void HandleValueCalculated(double value)
    {
        // Stocker la valeur calculée pour usage futur (analytics, personnalisation, etc.)
        // Pour le moment, on log juste pour débogage
        Console.WriteLine($"Valeur sponsor calculée: {value:C0}");
    }

    private async Task NavigateToDemo()
    {
        isLoading = true;
        StateHasChanged();

        // Simuler un chargement
        await Task.Delay(1500);

        Navigation.NavigateTo("/dashboard");
    }

    private async Task NavigateToLogin()
    {
        isLoading = true;
CloseMobileMenu();
        StateHasChanged();

        Navigation.NavigateTo("/login");
    }

        private async Task NavigateToRegister()
    {
        isLoading = true;
CloseMobileMenu();
        StateHasChanged();

        Navigation.NavigateTo("/login?s=true");
    }


    private void CancelLoading()
    {
        isLoading = false;
    }

    private void GoToDemo()
    {
        Navigation.NavigateTo("/dashboard");
    }
}

<style>
    .font-jakarta {
