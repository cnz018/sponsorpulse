@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenPdfCustomize { get; set; }
    private Event? _event;
    private bool _isLoading = true;
    private bool _isAnalyzing;
    private string? _lightboxUrl;
    private string? _analysisError;
    private StorytellingReponse? _storytelling;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var dbContext = await DbFactory.CreateDbContextAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (!authState.TryGetUserId(out var userId))
            {
                Navigation.NavigateTo("/login?message=sessionExpired");
                return;
            }

            dbContext.SetCurrentUser(userId);
            _event = await dbContext.Set<Event>()
                .Include(e => e.Media)
                .FirstOrDefaultAsync(e => e.Slug == Slug);

            if (_event is not null)
            {
                await using var analyticsContext = await AnalyticsDbFactory.CreateDbContextAsync();
                var analysis = await analyticsContext.StorytellingAnalyses
                    .AsNoTracking()
                    .FirstOrDefaultAsync(item => item.EventId == _event.Id);
                if (analysis is not null)
                {
                    _storytelling = System.Text.Json.JsonSerializer.Deserialize<StorytellingReponse>(analysis.ResponseJson);
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunStorytellingAnalysis()
    {
        if (_event is null || _isAnalyzing)
            return;

        _isAnalyzing = true;
        _analysisError = null;

        try
        {
            var response = await StorytellingService.GenerateStorytellingAsync(_event.Slug);
            if (!response.Success || response.Data is null)
            {
                _analysisError = response.ErrorMessage ?? "L'analyse storytelling a échoué.";
                return;
            }

            _storytelling = response.Data;
            await using var analyticsContext = await AnalyticsDbFactory.CreateDbContextAsync();
            var analysis = await analyticsContext.StorytellingAnalyses
                .FirstOrDefaultAsync(item => item.EventId == _event.Id);
            if (analysis is null)
            {
                analysis = new() { EventId = _event.Id };
                analyticsContext.StorytellingAnalyses.Add(analysis);
            }

            analysis.ResponseJson = System.Text.Json.JsonSerializer.Serialize(_storytelling);
            analysis.GeneratedAt = DateTime.UtcNow;
            await analyticsContext.SaveChangesAsync();
        }
        catch (Exception exception)
        {
            _analysisError = $"Erreur pendant l'analyse : {exception.Message}";
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    private void GoBack()
    {
        if (OnClose.HasDelegate)
        {
            OnClose.InvokeAsync();
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleDataUpdated(Event updatedEvent)
    {
        _event = updatedEvent;
        using var context = await DbFactory.CreateDbContextAsync();

        context.Events.Update(_event);
        await context.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task HandleMediaUploaded(List<UploadedMediaResult> results)
    {
        if (_event is null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var eventEntity = await context.Events.Include(e => e.Media).FirstAsync(e => e.Id == _event.Id);

        foreach (var result in results)
        {
            if (eventEntity.Media.Count >= 5) break;

            var media = EventMedia.Create(
                result.OriginalFileName,
                result.StorageFileName,
                result.Url,
                result.Size,
                result.ContentType
            );

            eventEntity.Media.Add(media);
        }

        await context.SaveChangesAsync();
        // Reload to ensure we have the latest state (IDs etc)
        _event = eventEntity;

        StateHasChanged();
    }

    private async Task DeleteMedia(EventMedia media)
    {
        if (_event == null) return;

        // Optimistic UI update
        _event.Media.Remove(media);
        StateHasChanged();

        try
        {
            await MediaStorageService.DeleteMediaAsync(media.StorageFileName);

            using var context = await DbFactory.CreateDbContextAsync();
            var eventEntity = await context.Events.Include(e => e.Media).FirstAsync(e => e.Id == _event.Id);

            // Find and remove by ID
            var mediaToDelete = eventEntity.Media.FirstOrDefault(m => m.Id == media.Id);
            if (mediaToDelete != null)
            {
                eventEntity.Media.Remove(mediaToDelete);
                await context.SaveChangesAsync();
            }
        }
        catch (Exception)
        {
            // Revert on error
            _event.Media.Add(media);
            StateHasChanged();
        }
    }

    private void OpenLightbox(string url) => _lightboxUrl = url;
    private void CloseLightbox() => _lightboxUrl = null;

    private void OpenPdfCustomize()
    {
        OnOpenPdfCustomize.InvokeAsync(Slug);
    }

    private string GetSentimentSegmentClass(string key) => key.ToLowerInvariant() switch
    {
        "positif" => "segment-positive",
        "neutre" => "segment-neutral",
        "négatif" or "negatif" => "segment-negative",
        _ => "segment-neutral"
    };

    private string GetSentimentCardClass(string key) => key.ToLowerInvariant() switch
    {
        "positif" => "card-positive",
        "neutre" => "card-neutral",
        "négatif" or "negatif" => "card-negative",
        _ => "card-neutral"
    };

    private string GetSentimentValueClass(string key) => key.ToLowerInvariant() switch
    {
        "positif" => "value-positive",
        "neutre" => "value-neutral",
        "négatif" or "negatif" => "value-negative",
        _ => "value-neutral"
    };

    private string GetSentimentIcon(string key) => key.ToLowerInvariant() switch
    {
        "positif" => "https://api.iconify.design/ic:outline-sentiment-very-satisfied.svg",
        "neutre" => "https://api.iconify.design/ic:outline-sentiment-neutral.svg",
        "négatif" or "negatif" => "https://api.iconify.design/ic:outline-sentiment-dissatisfied.svg",
        _ => "https://api.iconify.design/ic:outline-sentiment-neutral.svg"
    };

    private string GetPlatformIcon(string? platform) => platform?.ToLowerInvariant() switch
    {
        "twitch" => "mdi:twitch",
        "twitter" => "mdi:twitter",
        "x" => "mdi:twitter",
        _ => "mdi:broadcast"
    };

    private string FormatNumber(long value)
    {
        if (value >= 1_000_000)
            return $"{value / 1_000_000.0:F1}M";
        if (value >= 1_000)
            return $"{value / 1_000.0:F0}K";
        return value.ToString("N0");
    }

    private string GetFlagCode(string country) => country.ToLowerInvariant() switch
    {
        "france" => "fr",
        "belgique" => "be",
        "suisse" => "ch",
        "canada" => "ca",
        "etats-unis" => "us",
        "united states" => "us",
        "usa" => "us",
        "royaume-uni" => "gb",
        "united kingdom" => "gb",
        "uk" => "gb",
        "allemagne" => "de",
        "germany" => "de",
        "espagne" => "es",
        "spain" => "es",
        "italie" => "it",
        "italy" => "it",
        "pays-bas" => "nl",
        "netherlands" => "nl",
        _ => "xx"
    };
