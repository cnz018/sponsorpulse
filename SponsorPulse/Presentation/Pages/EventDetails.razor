@page "/event/{Slug}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SponsorPulse.Application.Common.Interfaces
@using SponsorPulse.Application.Common.Extensions
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Infrastructure.Persistence
@using SponsorPulse.Infrastructure.Repositories
@using SponsorPulse.Application.Services
@using SponsorPulse.Presentation.Components.Twitch
@using SponsorPulse.Presentation.Components.Twitter
@using SponsorPulse.Presentation.Components.Media
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<SponsorPulseDbContext> DbFactory
@inject IDbContextFactory<SponsorPulseAnalyticsDbContext> AnalyticsDbFactory
@inject IMediaStorageService MediaStorageService
@inject NavigationManager Navigation

@inject AuthenticationStateProvider AuthStateProvider
@inject IStorytellingService StorytellingService

<PageTitle>@(_event?.Name ?? "Détails") - SponsorPulse</PageTitle>

<div class="modal-page-backdrop">
    <div class="modal-page-content glass-panel fade-in-up">
        <div class="header">
            <button class="back-btn" @onclick="GoBack">
                ← Retour
            </button>
            <div class="actions">
                <!-- Actions placeholder (Edit, Delete) -->
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="p-8 text-center text-gray-400">Chargement de l'événement...</div>
        }
        else if (_event == null)
        {
            <div class="p-8 text-center">
                <h2 class="text-xl text-white mb-2">Événement introuvable</h2>
                <p class="text-gray-400">L'événement demandé n'existe pas ou a été supprimé.</p>
                <button class="btn-primary mt-4" @onclick="GoBack">Retourner au tableau de bord</button>
            </div>
        }
        else
        {
            <div class="event-details">
                <h1 class="event-title mb-2">@_event.Name</h1>
                <div class="meta-row mb-8">
                    <span class="badge badge-@(_event.StreamPlatform?.ToLower() ?? "default")">
                        <img src="https://api.iconify.design/@(GetPlatformIcon(_event.StreamPlatform)).svg"
                             class="badge-platform-icon" alt="" />
                        @_event.StreamPlatform
                    </span>
                    <span class="meta-date">
                        <img src="https://api.iconify.design/ic:outline-calendar-today.svg" class="meta-icon" alt="" />
                        @_event.Date.ToLocalTime().ToLongDateString()
                    </span>
                    <span class="meta-slug">#@_event.Slug</span>
                </div>

                <div class="section mb-6">
                    <h3 class="section-title">Description</h3>
                    <p class="text-gray-300 leading-relaxed">@(_event.Description ?? "Aucune description fournie.")</p>
                </div>

                <div class="section mb-6 storytelling-section">
                    <div class="section-heading-row">
                        <h3 class="section-title">Analyse storytelling</h3>
                        <button class="btn-analysis" @onclick="RunStorytellingAnalysis" disabled="@_isAnalyzing">
                            @if (_isAnalyzing)
                            {
                                <span>Analyse en cours...</span>
                            }
                            else
                            {
                                <span>Lancer l'analyse</span>
                            }
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_analysisError))
                    {
                        <p class="analysis-error">@_analysisError</p>
                    }
                    else if (_storytelling?.Slides.Count > 0)
                    {
                        <div class="storytelling-slides">
                            @foreach (var slide in _storytelling.Slides)
                            {
                                <article class="storytelling-slide">
                                    <h4>@slide.Titre</h4>
                                    <p>@slide.Contenu</p>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-400">Aucune analyse générée pour le moment.</p>
                    }
                </div>

                @if (_event.StreamPlatform == "Twitch")
                {
                    <div class="section mb-6">
                        <h3 class="section-title">Données Stream</h3>
                        <TwitchFetcher EventToUpdate="@_event" OnDataUpdated="HandleDataUpdated" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(_event.TwitterHashtags))
                {
                    <div class="section mb-6">
                        <h3 class="section-title">Données Twitter</h3>
                        @if (_event.TwitterAnalytics != null)
                        {
                            <div class="demo-twitter-metrics">
                                <div class="hero-metric">
                                    <div class="hero-metric-label">
                                        <img src="https://api.iconify.design/ic:outline-monetization-on.svg" class="hero-icon"
                                             alt="" />
                                        <span>Valeur Publicitaire</span>
                                    </div>
                                    <span class="hero-metric-value">@_event.TwitterAnalytics.AdValueEquivalent.ToString("C0")</span>
                                </div>
                                <div class="detail-stats-row">
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-tag.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Total Tweets</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.TotalTweets.ToString("N0")</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-message.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Engagement Total</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.TotalEngagement.ToString("N0")</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-monitor.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Impressions</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.EstimatedImpressions.ToString("N0")</span>
                                    </div>
                                </div>

                                @* Nouvelles métriques complémentaires *@
                                <div class="detail-stats-row mt-4">
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-trending-up.svg" class="dsc-icon"
                                                 alt="" />
                                            <span class="dsc-label">ROI Estimé</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.EstimatedROI.ToString("C0")</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-people.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Reach Unique</span>
                                        </div>
                                        <span class="dsc-value">@FormatNumber(_event.TwitterAnalytics.UniqueReach)</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-account-balance.svg" class="dsc-icon"
                                                 alt="" />
                                            <span class="dsc-label">CPM</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.CPM.ToString("C2")</span>
                                    </div>
                                </div>

                                @* Top Influenceur *@
                                <div class="section mt-6">
                                    <h3 class="section-title">Top Influenceur</h3>
                                    <div class="influencer-card">

                                        @if (_event.TwitterAnalytics.TopInfluencer != null &&
                            !string.IsNullOrEmpty(_event.TwitterAnalytics.TopInfluencer.Handle))
                                        {
                                            <div class="influencer-header">
                                                <img src="https://api.iconify.design/ic:outline-star.svg" class="influencer-icon"
                                                     alt="" />
                                                <span class="influencer-name">@_event.TwitterAnalytics.TopInfluencer.Name</span>
                                                <span class="influencer-handle">@_event.TwitterAnalytics.TopInfluencer.Handle</span>
                                            </div>
                                            <div class="influencer-metrics">
                                                <div class="influencer-metric">
                                                    <img src="https://api.iconify.design/ic:outline-people.svg"
                                                         class="metric-icon-small" alt="" />
                                                    <span>@_event.TwitterAnalytics.TopInfluencer.FollowersCount.ToString("N0")
                                                        followers</span>
                                                    </div>
                                                    <div class="influencer-metric">
                                                        <img src="https://api.iconify.design/ic:outline-percent.svg"
                                                             class="metric-icon-small" alt="" />
                                                        <span>@(_event.TwitterAnalytics.TopInfluencer.AvgEngagementRate *
                                                                                                                                                                                                                                                                                                    100).ToString("F1")% engagement</span>
                                                        </div>
                                                        <div class="influencer-metric">
                                                            <img src="https://api.iconify.design/ic:outline-chat.svg" class="metric-icon-small"
                                                                 alt="" />
                                                            <span>@_event.TwitterAnalytics.TopInfluencer.TweetCount tweets</span>
                                                        </div>
                                                        <div class="influencer-metric">
                                                            <img src="https://api.iconify.design/ic:outline-remove-red-eye.svg"
                                                                 class="metric-icon-small" alt="" />
                                                            <span>@FormatNumber(_event.TwitterAnalytics.TopInfluencer.EstimatedReach)
                                                                reach</span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            @* Top Hashtags *@
                                            @if (_event.TwitterAnalytics.TopHashtags?.Any() == true)
                                            {
                                                <div class="section mt-6">
                                                    <h3 class="section-title">Top Hashtags</h3>
                                                    <div class="hashtags-list">
                                                        @foreach (var hashtag in _event.TwitterAnalytics.TopHashtags.Take(5))
                                                        {
                                                            <div class="hashtag-item">
                                                                <span class="hashtag-tag">#@hashtag.Tag</span>
                                                                <span class="hashtag-count">@hashtag.UsageCount</span>
                                                                <span class="hashtag-engagement">@hashtag.TotalEngagements engagements</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @* Répartition Géographique *@
                                            @if (_event.TwitterAnalytics.GeographicReach?.Any() == true)
                                            {
                                                <div class="section mt-6">
                                                    <h3 class="section-title">Répartition Géographique</h3>
                                                    <div class="geo-list">
                                                        @foreach (var geo in _event.TwitterAnalytics.GeographicReach.Take(5))
                                                        {
                                                            <div class="geo-item">
                                                                <div class="geo-header">
                                                                    <img src="https://flagcdn.com/w40/@(GetFlagCode(geo.Country)).png" class="flag-icon"
                                                                         alt="@geo.Country" />
                                                                    <span class="geo-country">@geo.Country</span>
                                                                    <span class="geo-percentage">@geo.Percentage.ToString("F1")%</span>
                                                                </div>
                                                                <div class="geo-bar">
                                                                    <div class="geo-bar-fill" style="width: @geo.Percentage%"></div>
                                                                </div>
                                                                <span class="geo-impressions">@geo.Impressions.ToString("N0") impressions</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (_event.TwitterAnalytics.TopTweets?.Any() == true)
                                            {
                                                <div class="top-tweets-section mt-6">
                                                    <h4 class="tweets-title">Top Tweets</h4>
                                                    <div class="tweets-list">
                                                        @foreach (var tweet in _event.TwitterAnalytics.TopTweets.Take(3))
                                                        {
                                                            <div class="tweet-card">
                                                                <div class="tweet-header">
                                                                    <span class="tweet-author">@tweet.AuthorName</span>
                                                                    <span class="tweet-handle">@tweet.AuthorHandle</span>
                                                                    <span class="tweet-followers">(@tweet.AuthorFollowersCount.ToString("N0")
                                                                        followers)</span>
                                                                    </div>
                                                                    <p class="tweet-text">@tweet.Text</p>
                                                                    <div class="tweet-metrics">
                                                                        <span class="tweet-metric-item">
                                                                            <img src="https://api.iconify.design/ic:outline-favorite.svg" class="tweet-icon"
                                                                                 alt="" />
                                                                            @tweet.Likes.ToString("N0")
                                                                        </span>
                                                                        <span class="tweet-metric-item">
                                                                            <img src="https://api.iconify.design/ic:outline-repeat.svg" class="tweet-icon"
                                                                                 alt="" />
                                                                            @tweet.Retweets.ToString("N0")
                                                                        </span>
                                                                        <span class="tweet-metric-item">
                                                                            <img src="https://api.iconify.design/ic:outline-chat-bubble-outline.svg"
                                                                                 class="tweet-icon" alt="" />
                                                                            @tweet.Replies.ToString("N0")
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                @if (_event.TwitterAnalytics.SentimentRatio?.Any() == true)
                                                {
                                                    <div class="sentiment-section mt-6">
                                                        <h4 class="tweets-title">Sentiment</h4>
                                                        <div class="sentiment-stacked-bar">
                                                            @foreach (var sentiment in _event.TwitterAnalytics.SentimentRatio)
                                                            {
                                                                <div class="sentiment-segment @GetSentimentSegmentClass(sentiment.Key)"
                                                                     style="width: @sentiment.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                                                     title="@sentiment.Key : @sentiment.Value.ToString("F1")%"></div>
                                                            }
                                                        </div>
                                                        <div class="sentiment-cards">
                                                            @foreach (var sentiment in _event.TwitterAnalytics.SentimentRatio)
                                                            {
                                                                <div class="sentiment-card @GetSentimentCardClass(sentiment.Key)">
                                                                    <img src="@GetSentimentIcon(sentiment.Key)" class="sentiment-icon" alt="" />
                                                                    <span
                                                                    class="sentiment-pct @GetSentimentValueClass(sentiment.Key)">@sentiment.Value.ToString("F1")%</span>
                                                                    <span class="sentiment-card-label">@sentiment.Key</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <TwitterFetcher EventToUpdate="@_event" OnDataUpdated="HandleDataUpdated" />
                                        }
                                    </div>
                                }

                                <div class="section mb-6 mt-8" id="media-section">
                                    <h3 class="section-title">Médias Événement (Photos)</h3>
                                    <div class="media-container mb-4">
                                        @if (_event.Media.Any())
                                        {
                                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                                                @foreach (var media in _event.Media)
                                                {
                                                    <div class="media-card group relative">
                                                        <img src="@media.Url" alt="@media.OriginalFileName"
                                                             class="w-full h-32 object-cover rounded-lg border border-white/10"
                                                             @onclick="() => OpenLightbox(media.Url)" />

                                                        <button
                                                            class="btn-delete-media absolute top-2 right-2 bg-red-500/80 hover:bg-red-600 text-white p-1 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
                                                            @onclick="() => DeleteMedia(media)" @onclick:stopPropagation>
                                                            <span class="icon-small">🗑️</span>
                                                        </button>
                                                        <span class="text-xs text-gray-400 mt-1 block truncate">@media.OriginalFileName</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @if (_event.Media.Count < 5)
                                    {
                                        <MediaUploader EventSlug="@_event.Slug" OnUploadCompleted="HandleMediaUploaded" />
                                    }
                                    else if (_event.Media.Count >= 5)
                                    {
                                        <p class="text-yellow-500 text-sm">Limite de 5 photos atteinte.</p>
                                    }
                                </div>

                                <div class="section mt-8 pt-6 border-t border-gray-800">
                                    <button class="btn-generate" @onclick="OpenPdfCustomize">
                                        <img src="https://api.iconify.design/ic:outline-picture-as-pdf.svg" class="btn-generate-icon"
                                             alt="" />
                                        Générer Rapport
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (_lightboxUrl != null)
                {
                    <div class="fixed inset-0 z-[2000] bg-black/90 flex items-center justify-center p-4 backdrop-blur-sm"
                         @onclick="CloseLightbox">
                        <div class="relative max-w-7xl max-h-screen">
                            <button class="absolute -top-12 right-0 text-white hover:text-gray-300 text-3xl"
                                    @onclick="CloseLightbox">✕</button>
                            <img src="@_lightboxUrl" class="max-h-[85vh] max-w-full rounded-lg shadow-2xl" @onclick:stopPropagation />
                        </div>
                    </div>
                }

                <style>
                    .modal-page-backdrop {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100vw;
                        height: 100vh;
                        background: rgba(5, 10, 20, 0.85);
                        /* Dark overlay */
                        backdrop-filter: blur(8px);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        z-index: 1000;
                        padding: 1rem;
                    }

                    .modal-page-content {
                        width: 100%;
                        max-width: 800px;
                        max-height: 90vh;
                        overflow-y: auto;
                        padding: 2.5rem;
                        border-radius: 24px;
                        background: linear-gradient(145deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
                        border: 1px solid rgba(255, 255, 255, 0.1);
                        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
                    }

                    .header {
                        display: flex;
                        justify-content: space-between;
                        margin-bottom: 2rem;
                    }

                    .back-btn {
                        background: transparent;
                        border: none;
                        color: var(--lavender);
                        cursor: pointer;
                        font-weight: 600;
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                        padding: 0.4rem 0.75rem;
                        font-size: 0.9rem;
                        opacity: 0.8;
                        transition: opacity 0.2s, transform 0.2s, background 0.2s;
                        border-radius: var(--radius-btn);
                    }

                    .back-btn:hover {
                        opacity: 1;
                        transform: translateX(-3px);
                        background: rgba(204, 201, 220, 0.08);
                    }

                    .section-title {
                        color: var(--grey-text);
                        text-transform: uppercase;
                        letter-spacing: 0.08em;
                        font-size: 0.7rem;
                        margin-bottom: 1rem;
                        font-weight: 700;
                        display: flex;
                        align-items: center;
                        gap: 0.6rem;
                    }

                    .section-title::before {
                        content: '';
                        display: inline-block;
                        width: 3px;
                        height: 13px;
                        background: var(--lavender);
                        border-radius: 2px;
                        opacity: 0.45;
                        flex-shrink: 0;
                    }

                    .badge {
                        background: rgba(59, 130, 246, 0.2);
                        color: #60A5FA;
                        border: 1px solid rgba(59, 130, 246, 0.4);
                        padding: 0.25rem 0.75rem;
                        border-radius: 99px;
                        font-size: 0.85rem;
                        font-weight: 600;
                    }

                    .date {
                        color: var(--grey-text);
                        margin-left: 1rem;
                    }

                    .code-block {
                        background: rgba(0, 0, 0, 0.3);
                        padding: 0.75rem 1rem;
                        border-radius: 8px;
                        font-family: monospace;
                        color: var(--lavender);
                        border: 1px solid rgba(255, 255, 255, 0.05);
                        display: inline-block;
                    }

                    .btn-action {
                        background: linear-gradient(135deg, var(--accent-blue) 0%, #2563EB 100%);
                        color: white;
                        border: none;
                        padding: 0.75rem 1.5rem;
                        border-radius: 8px;
                        font-weight: 600;
                        cursor: pointer;
                        transition: transform 0.2s, box-shadow 0.2s;
                    }

                    .btn-action:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
                    }

                    /* Media Grid Styles */
                    .media-card {
                        transition: transform 0.2s;
                    }

                    .media-card:hover {
                        transform: scale(1.02);
                    }

                    .icon-small {
                        font-size: 0.8rem;
                    }

                    .fade-in-up {
                        animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
                    }

                    @@keyframes fadeInUp {
                        from {
                            opacity: 0;
                            transform: translateY(20px) scale(0.98);
                        }

                        to {
                            opacity: 1;
                            transform: translateY(0) scale(1);
                        }
                    }

                    /* Detail Stat Cards */
                    .detail-stats-row {
                        display: grid;
                        grid-template-columns: repeat(3, 1fr);
                        gap: 0.875rem;
                    }

                    .detail-stat-card {
                        background: linear-gradient(145deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.015) 100%);
                        border: 1px solid rgba(148, 163, 184, 0.12);
                        border-radius: 12px;
                        padding: 1rem 1.125rem;
                        display: flex;
                        flex-direction: column;
                        gap: 0.5rem;
                        transition: border-color 0.2s, transform 0.2s;
                    }

                    .detail-stat-card:hover {
                        border-color: rgba(204, 201, 220, 0.22);
                        transform: translateY(-2px);
                    }

                    .dsc-header {
                        display: flex;
                        align-items: center;
                        gap: 0.45rem;
                    }

                    .dsc-icon {
                        width: 14px;
                        height: 14px;
                        filter: brightness(0) saturate(100%) invert(65%) sepia(10%) saturate(200%) hue-rotate(194deg) brightness(90%) contrast(90%);
                        flex-shrink: 0;
                    }

                    .dsc-label {
                        font-size: 0.67rem;
                        color: var(--grey-text);
                        text-transform: uppercase;
                        letter-spacing: 0.07em;
                        font-weight: 600;
                    }

                    .dsc-value {
                        font-size: 1.6rem;
                        font-weight: 700;
                        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                        line-height: 1.2;
                        padding: 0.1rem 0;
                    }

                    /* Inline labeled field (non-numeric values like Jeu) */
                    .info-field {
                        display: flex;
                        align-items: center;
                        gap: 1rem;
                        margin-top: 0.75rem;
                        padding: 0.6rem 0.875rem;
                        background: rgba(255, 255, 255, 0.02);
                        border-radius: 8px;
                        border: 1px solid rgba(148, 163, 184, 0.07);
                    }

                    .info-field-label {
                        font-size: 0.67rem;
                        color: var(--grey-text);
                        text-transform: uppercase;
                        letter-spacing: 0.07em;
                        font-weight: 600;
                        white-space: nowrap;
                        min-width: 2rem;
                    }

                    .info-field-value {
                        font-size: 1rem;
                        font-weight: 600;
                        color: var(--white);
                    }

                    /* Hero metric banner (most commercially important stat) */
                    .hero-metric {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        padding: 1.125rem 1.375rem;
                        margin-bottom: 0.875rem;
                        background: linear-gradient(135deg, rgba(204, 201, 220, 0.07) 0%, rgba(204, 201, 220, 0.02) 100%);
                        border: 1px solid rgba(204, 201, 220, 0.18);
                        border-radius: 12px;
                    }

                    .hero-metric-label {
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                        font-size: 0.7rem;
                        color: var(--grey-text);
                        text-transform: uppercase;
                        letter-spacing: 0.08em;
                        font-weight: 700;
                    }

                    .hero-icon {
                        width: 16px;
                        height: 16px;
                        filter: brightness(0) saturate(100%) invert(85%) sepia(6%) saturate(19%) hue-rotate(194deg) brightness(94%) contrast(93%);
                    }

                    .hero-metric-value {
                        font-size: 2rem;
                        font-weight: 700;
                        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                        line-height: 1;
                    }

