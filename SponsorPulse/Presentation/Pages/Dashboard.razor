@page "/dashboard"
@rendermode RenderMode.InteractiveServer
@* @attribute [Microsoft.AspNetCore.Authorization.Authorize] *@
@using Microsoft.AspNetCore.Components.Authorization
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Infrastructure.Persistence
@using SponsorPulse.Presentation.Components
@using SponsorPulse.Infrastructure.Repositories
@using SponsorPulse.Application.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using LumexUI
@using LumexUI.Common
@using SponsorPulse.Application.Common.Extensions

@inject NavigationManager Navigation
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory
@inject IDemoDataService DemoDataService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard - SponsorPulse</PageTitle>

<div class="dashboard-content fade-in">
    <div class="header-panel mb-8">
        <h1 class="text-3xl font-bold text-white mb-6">Événements</h1>
        <LumexButton Class="ml-auto text-white" Variant="@Variant.Ghost" OnClick="GoToCreate">Créer un événement
        </LumexButton>
    </div>

    @* Stats Cards Section *@
    @if (dashboardStats != null)
    {
        <div class="stats-grid mb-8">
            <StatCard Title="Pic de Viewers" Value="@dashboardStats.PeakViewers.ToString("N0")"
                      IconUrl="https://api.iconify.design/ic:outline-remove-red-eye.svg" />

            <StatCard Title="Engagement Total" Value="@dashboardStats.TotalEngagement.ToString("N0")"
                      IconUrl="https://api.iconify.design/ic:outline-message.svg" />

            <StatCard Title="Impressions Totales" Value="@FormatImpressions(dashboardStats.TotalImpressions)"
                      IconUrl="https://api.iconify.design/ic:outline-monitor.svg" />
        </div>
    }

    <AuthorizeView>
        <Authorized>
            <EventSelector Events="events" OnEdit="HandleEditEvent" OnDelete="HandleDeleteEvent"
                           OnAnalyze="HandleAnalyzeEvent" OnGenerate="HandleGenerateEvent" OnBulkAnalyze="HandleBulkAnalyze"
                           OnBulkDelete="HandleBulkDelete" OnNavigateToEvent="HandleNavigateToEvent" />
        </Authorized>
        <Authorizing>
            <div class="text-center text-gray-400 mt-8">
                <p>Chargement des événements...</p>
            </div>
        </Authorizing>
        <NotAuthorized>
            <div class="text-center text-gray-400 mt-8">
                <p>Vous devez être connecté pour voir vos événements.</p>
                <LumexButton Class="mt-4" Variant="@Variant.Ghost" OnClick="@(() => Navigation.NavigateTo("/login"))">
                    Se connecter
                </LumexButton>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <div class="waitlist-card mt-8">
        <div class="waitlist-content">
            <div class="waitlist-icon">
                <img src="https://api.iconify.design/ic:outline-mail.svg" alt="" />
            </div>
            <div class="waitlist-text">
                <h3 class="waitlist-title">Rejoignez notre waitlist</h3>
                <p class="waitlist-description">
                    Soyez parmi les premiers à accéder à SponsorPulse et découvrez toutes nos fonctionnalités
                    exclusives.
                </p>
            </div>
        </div>

        @if (!waitlistSubmitted)
        {
            <div class="waitlist-form-wrapper">
                <div class="waitlist-input-container text-gray-400">
                    <LumexTextbox @bind-Value="waitlistEmail" @onkeypress="HandleEnterKey" Placeholder="mon.mail@exemple.fr"
                                  Class="waitlist-input" Disabled="waitlistLoading" />

                    @if (!string.IsNullOrEmpty(waitlistError))
                    {
                        <p class="waitlist-error">@waitlistError</p>
                    }
                </div>

                <LumexButton Class="text-white whitespace-nowrap" Radius="@Radius.Small" @onclick="SubmitWaitlist"
                             Disabled="waitlistLoading" Variant="@Variant.Ghost">
                    @if (waitlistLoading)
                    {
                        <div class="flex items-center gap-2">
                            <div class="spinner-small"></div>
                            <span>Envoi...</span>
                        </div>
                    }
                    else
                    {
                        <span>Rejoindre</span>
                    }
                </LumexButton>
            </div>
        }
        else
        {
            <div class="waitlist-success">
                <div class="success-icon">🎉</div>
                <div class="success-content">
                    <p class="success-title">Merci !</p>
                    <p class="success-subtitle">Vous êtes inscrit à la waitlist</p>
                </div>
            </div>
        }
    </div>

    @if (showCreateModal)
    {
        <CreateEvent OnClose="@(() => showCreateModal = false)" OnCreated="HandleEventCreated" />
    }

    @if (eventToDelete != null)
    {
        <div class="modal-backdrop" @onclick="CancelDelete">
            <div class="modal-content glass-panel" @onclick:stopPropagation>
                <div class="mb-4">
                    <h2 class="text-xl font-bold text-white">Supprimer définitivement</h2>
                </div>

                <p class="text-gray-300 mb-6">
                    Etes vous sur de vouloir supprimer cet event <strong>@eventToDelete.Name</strong> ?
                </p>

                <div class="flex justify-end gap-4">
                    <button class="btn-cancel" @onclick="CancelDelete">Annuler</button>
                    <button class="btn-delete-confirm" @onclick="ConfirmDelete">Oui, Supprimer</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .dashboard-content {
        animation: fadeIn 0.5s ease-out;
        padding-bottom: 4rem;
    }

    /* Modal Styles */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        animation: fadeIn 0.2s ease-out;
    }

    .modal-content {
        width: 90%;
        max-width: 500px;
        padding: 2rem;
        border-radius: 16px;
        background: var(--dark-bg);
        border: 1px solid var(--glass-border);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid var(--glass-border);
        color: var(--grey-text);
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
    }

    .btn-cancel:hover {
        color: var(--white);
        border-color: var(--grey-text);
    }

    .btn-delete-confirm {
        background: #DC2626;
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-delete-confirm:hover {
        background: #EF4444;
    }

    .flex {
        display: flex;
    }

    .justify-end {
        justify-content: flex-end;
    }

    .gap-4 {
        gap: 1rem;
    }


    .header-panel {
        height: 2rem;
        background-color: transparent;
        border-radius: 16px;
        display: flex;
        align-items: space-around;
    }

    .glass-panel-message {
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.03);
    }

    .mb-8 {
        margin-bottom: 2rem;
    }

    .mb-6 {
        margin-bottom: 1.5rem;
    }

    .mb-2 {
        margin-bottom: 0.5rem;
    }

    .text-3xl {
        font-size: 1.875rem;
    }

    .text-xl {
        font-size: 1.25rem;
    }

    .font-bold {
        font-weight: 700;
    }

    .text-gray-400 {
        color: var(--grey-text);
    }

    .text-white {
        color: var(--white);
    }

    .col-span-full {
        grid-column: 1 / -1;
    }

    .text-center {
        text-align: center;
    }

    .p-8 {
        padding: 2rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    /* Waitlist Card */
    .waitlist-card {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        transition: all 0.3s ease;
    }

    .waitlist-card:hover {
        border-color: rgba(148, 163, 184, 0.3);
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.03) 100%);
    }

    .waitlist-content {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        width: 65%;
    }

    .waitlist-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.15);
        flex-shrink: 0;
    }

    .waitlist-icon img {
        width: 24px;
        height: 24px;
        filter: brightness(0) saturate(100%) invert(73%) sepia(74%) saturate(360%) hue-rotate(174deg) brightness(94%) contrast(96%);
    }

    .waitlist-text {
        flex: 1;
    }

    .waitlist-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 0.25rem;
    }

    .waitlist-description {
        font-size: 0.875rem;
        color: var(--grey-text);
        line-height: 1.4;
    }

    .waitlist-form-wrapper {
        display: flex;
        align-items: start;
        gap: 0.75rem;
        flex: 1;
        max-width: 400px;
    }

    .waitlist-input-container {
        flex: 1;
        min-width: 400px;
    }

    .waitlist-input {
        width: 100%;
    }

    .waitlist-error {
        color: #EF4444;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    .btn-cta-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
    }

    .btn-cta-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .waitlist-success {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.3);
        border-radius: 12px;
    }

    .success-icon {
        font-size: 2rem;
    }

    .success-content {
        display: flex;
        flex-direction: column;
    }

    .success-title {
        font-weight: 600;
        color: var(--white);
        font-size: 1rem;
    }

    .success-subtitle {
        font-size: 0.875rem;
        color: var(--grey-text);
    }

    .spinner-small {
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .mt-8 {
        margin-top: 2rem;
    }

    .whitespace-nowrap {
        white-space: nowrap;
    }
</style>

@code {
    private bool showCreateModal = false;
    private List<Event>? events = [];
    private Event? eventToDelete;
    private DashboardStats? dashboardStats;

    // Waitlist
    private string waitlistEmail = "";
    private bool waitlistSubmitted = false;
    private bool waitlistLoading = false;
    private string waitlistError = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
        await LoadDashboardStats();
    }

    private async Task LoadDashboardStats()
    {
        dashboardStats = await DemoDataService.GetDashboardStatsAsync();
        StateHasChanged();
    }

    private async Task LoadEvents()
    {
        if (DemoDataService.IsInDemoMode)
        {
            // En mode démo, charger depuis le service qui utilise StaticDemoRepository
            events = (await DemoDataService.GetDemoEventsAsync()).OrderByDescending(e => e.Date).ToList();
        }
        else
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (!authState.TryGetUserId(out Guid? userId))
            {
                Navigation.NavigateTo("/login?message=sessionExpired");

                return;
            }


            using var dbContext = await DbFactory.CreateDbContextAsync();

            dbContext.SetCurrentUser(userId);

            events = await dbContext.Set<Event>()
            .AsNoTracking()
            .OrderByDescending(e => e.Date)
            .ToListAsync();
        }
    }

    private string FormatImpressions(long impressions)
    {
        if (impressions >= 1_000_000)
            return $"{impressions / 1_000_000.0:F1}M";
        if (impressions >= 1_000)
            return $"{impressions / 1_000.0:F0}K";
        return impressions.ToString("N0");
    }

    private void GoToCreate()
    {
        showCreateModal = true;
    }

    private void HandleEditEvent(Event evt)
    {
        // Naviguer vers la page des métrique/détails de l'événement
        Navigation.NavigateTo($"event/{evt.Slug}/metrics");
    }

    private void HandleAnalyzeEvent(Event evt)
    {
        // Naviguer vers la page d'analyse
        Navigation.NavigateTo($"event/{evt.Slug}/analyze");
    }

    private void HandleGenerateEvent(Event evt)
    {
        // Naviguer vers la génération PDF
        Navigation.NavigateTo($"event/{evt.Slug}/pdf-customize");
    }

    private void HandleDeleteEvent(Event evt)
    {
        eventToDelete = evt;
    }

    private void HandleBulkAnalyze()
    {
        // TODO: Analyser les événements sélectionnés
        Console.WriteLine("Bulk analyze triggered");
    }

    private void HandleBulkDelete()
    {
        // TODO: Afficher une confirmation avant suppression en masse
        Console.WriteLine("Bulk delete triggered");
    }

    private void CancelDelete()
    {
        eventToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (eventToDelete == null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var evt = await context.Events.FindAsync(eventToDelete.Id);
        if (evt != null)
        {
            context.Events.Remove(evt);
            await context.SaveChangesAsync();
        }

        eventToDelete = null;
        await LoadEvents();
    }

    private async Task HandleEventCreated()
    {
        await LoadEvents();
        StateHasChanged();
    }

    private void HandleNavigateToEvent(string action)
    {
        if (action == "create")
        {
            showCreateModal = true;
        }
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !waitlistLoading)
        {
            await SubmitWaitlist();
        }
    }

    private async Task SubmitWaitlist()
    {
        if (string.IsNullOrWhiteSpace(waitlistEmail))
        {
            waitlistError = "Veuillez entrer une adresse email";
            return;
        }

        if (!waitlistEmail.Contains("@"))
        {
            waitlistError = "Veuillez entrer une adresse email valide";
            return;
        }

        waitlistError = "";
        waitlistLoading = true;
        StateHasChanged();

        // TODO: Appeler l'API d'inscription à la waitlist
        await Task.Delay(1000); // Simulation

        waitlistLoading = false;
        waitlistSubmitted = true;
        StateHasChanged();
    }
}
