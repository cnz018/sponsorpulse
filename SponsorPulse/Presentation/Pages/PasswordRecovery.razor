@layout EmptyLayout
@page "/password-recovery"
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using LumexUI
@using LumexUI.Common
@using SponsorPulse.Presentation.Components

@inject UserManager<SponsorPulse.Domain.Entities.ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Récupération mot de passe - SponsorPulse</PageTitle>

<div class="min-h-screen gradient-mesh font-jakarta">
    <!-- Navbar avec BrandLogo -->
    <LumexNavbar Sticky="@false" Blurred="@false" Bordered="@false" Height="5rem" Class="login-navbar">
        <LumexNavbarBrand>
            <div @onclick="@(() => Navigation.NavigateTo("/"))" style="cursor: pointer;">
                <BrandLogo />
            </div>
        </LumexNavbarBrand>
    </LumexNavbar>

    <!-- Main Auth Content -->
    <div class="auth-container">
        <!-- Décor Background -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute top-20 left-10 w-72 h-72 bg-red-500/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl"></div>
        </div>

        <!-- Auth Card -->
        <div class="auth-card recovery-card">
            <div class="auth-header">
                <h1 class="auth-title">Récupérer votre compte</h1>
                <p class="auth-subtitle">Entrez votre email pour recevoir un lien de réinitialisation</p>
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                @if (message.Contains("Un e-mail") || message.Contains("Si un compte"))
                {
                    <div class="auth-success">
                        <span class="success-icon">✓</span>
                        <div>
                            <p class="success-title">Demande envoyée</p>
                            <p class="success-subtitle">@message</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="auth-error">
                        <span>@message</span>
                    </div>
                }
            }

            <EditForm Model="model" OnValidSubmit="HandleRequest" class="auth-form">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email" class="form-label">Adresse email</label>
                    <InputText @bind-Value="model.Email" id="email" class="form-input-styled" placeholder="vous@exemple.com" />
                    <ValidationMessage For="@(() => model.Email)" class="form-error-message" />
                </div>

                <LumexButton class="btn-primary w-full" Type="ButtonType.Submit" Variant="@Variant.Ghost">
                    Envoyer le lien de réinitialisation
                </LumexButton>
            </EditForm>

            <div class="auth-footer">
                <p class="recovery-info">Un lien de réinitialisation vous sera envoyé par email si votre compte existe dans notre système.</p>
                
                <div class="auth-footer-links">
                    <LumexLink Href="/login" class="auth-link">Retour à la connexion</LumexLink>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RequestModel model = new();
    private string? message;

    private class RequestModel
    {
        [Required(ErrorMessage = "L'email est requis")]
        [EmailAddress(ErrorMessage = "Veuillez entrer une adresse email valide")]
        public string Email { get; set; } = string.Empty;
    }

    private async Task HandleRequest()
    {
        var user = await UserManager.FindByEmailAsync(model.Email);
        if (user == null)
        {
            // Ne pas révéler l'existence d'un compte
            message = "Si un compte existe pour cette adresse, vous recevrez un email sous peu.";
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);

        // TODO: Envoyer le token par email. En mode démo on affiche un message générique.
        message = "Un e-mail de réinitialisation a été demandé. (Dans un environnement réel, un email serait envoyé.)";
    }
}

<style>
    .font-jakarta {
        font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .gradient-mesh {
        background: linear-gradient(135deg, rgba(12, 24, 33, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
        position: relative;
    }

    .login-navbar {
        background: transparent !important;
        backdrop-filter: none !important;
        border-bottom: none !important;
        position: sticky !important;
        top: 0 !important;
        z-index: 1000 !important;
        transition: background 0.3s ease !important;
    }

    .auth-container {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 5rem);
        padding: 2rem;
    }

    .auth-card {
        position: relative;
        z-index: 10;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(204, 201, 220, 0.15);
        border-radius: 24px;
        padding: 3rem;
        max-width: 450px;
        width: 100%;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
        animation: slideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .recovery-card {
        min-height: auto;
    }

    .auth-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .auth-title {
        background: linear-gradient(135deg, #CCC9DC 0%, #324A5F 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
        line-height: 1.2;
    }

    .auth-subtitle {
        color: #94A3B8;
        font-size: 0.95rem;
        margin: 0;
    }

    .auth-error {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(248, 113, 113, 0.1);
        border: 1px solid rgba(248, 113, 113, 0.3);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        color: #F87171;
        font-size: 0.9rem;
        animation: shake 0.3s ease-in-out;
    }

    .auth-success {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.3);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        animation: slideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .success-icon {
        font-size: 1.5rem;
        color: #22C55E;
        line-height: 1;
    }

    .success-title {
        color: white;
        font-weight: 600;
        font-size: 1rem;
        margin: 0 0 0.25rem 0;
    }

    .success-subtitle {
        color: #94A3B8;
        font-size: 0.875rem;
        margin: 0;
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        color: #CCC9DC;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .form-input-styled {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(204, 201, 220, 0.15);
        border-radius: 8px;
        color: white;
        font-size: 0.95rem;
        font-family: inherit;
        transition: all 0.2s ease;
    }

    .form-input-styled:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(204, 201, 220, 0.3);
        box-shadow: 0 0 12px rgba(204, 201, 220, 0.1);
    }

    .form-input-styled::placeholder {
        color: rgba(148, 163, 184, 0.6);
    }

    .form-error-message {
        color: #F87171;
        font-size: 0.8rem;
        margin-top: 0.25rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, rgba(204, 201, 220, 0.2) 0%, rgba(50, 74, 95, 0.2) 100%) !important;
        border: 1px solid rgba(204, 201, 220, 0.3) !important;
        color: white !important;
        font-weight: 600 !important;
        padding: 0.875rem 1.5rem !important;
        border-radius: 8px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, rgba(204, 201, 220, 0.3) 0%, rgba(50, 74, 95, 0.3) 100%) !important;
        border-color: rgba(204, 201, 220, 0.5) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 12px 24px rgba(204, 201, 220, 0.1) !important;
    }

    .auth-footer {
        text-align: center;
        margin-top: 1.5rem;
        border-top: 1px solid rgba(204, 201, 220, 0.1);
        padding-top: 1.5rem;
    }

    .recovery-info {
        color: #94A3B8;
        font-size: 0.85rem;
        line-height: 1.6;
        margin: 0 0 1rem 0;
    }

    .auth-footer-links {
        display: flex;
        justify-content: center;
        gap: 1rem;
    }

    .auth-link {
        color: #94A3B8 !important;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

    .auth-link:hover {
        color: #CCC9DC !important;
        text-decoration: underline;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-8px); }
        75% { transform: translateX(8px); }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .auth-card {
            padding: 2rem;
            border-radius: 16px;
        }

        .auth-title {
            font-size: 1.5rem;
        }

        .auth-subtitle {
            font-size: 0.85rem;
        }

        .auth-container {
            min-height: calc(100vh - 4rem);
            padding: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .auth-card {
            padding: 1.5rem;
        }

        .auth-title {
            font-size: 1.25rem;
        }

        .form-label {
            font-size: 0.85rem;
        }

        .form-input-styled {
            padding: 0.65rem 0.875rem;
            font-size: 0.9rem;
        }
    }

    /* LumexUI Integration */
    :deep(.lumex-button) {
        border-radius: 8px !important;
    }

    :deep(.lumex-navbar) {
        background: transparent !important;
    }

    :deep(.lumex-navbar-brand) {
        cursor: pointer;
        transition: transform 0.2s ease;
    }

    :deep(.lumex-navbar-brand:hover) {
        transform: scale(1.05);
    }
</style>
