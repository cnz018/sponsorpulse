@page "/event/{Slug}/pdf-customize"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode RenderMode.InteractiveServer
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Infrastructure.Repositories
@using SponsorPulse.Application.Services
@using SponsorPulse.Application.Common.Models
@using SponsorPulse.Application.Common.Interfaces
@using SponsorPulse.Application.Common.Configuration
@using SponsorPulse.Application.Common.Extensions
@using SponsorPulse.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IPdfGenerationService PdfGenerationService
@inject IStorytellingService StorytellingService
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory
@inject IDbContextFactory<SponsorPulseAnalyticsDbContext> AnalyticsDbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.Extensions.Options.IOptions<ReportSettings> ReportOptions
@inject IJSRuntime JS

<style>
    .card-bg {
        padding: 2rem;
        border-radius: 12px;
        background: rgba(30, 41, 59, 0.3);
        border: 1px solid rgba(148, 163, 184, 0.2);
    }

    .input-field {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.3);
        border-radius: 8px;
        background: rgba(15, 23, 42, 0.5);
        color: white;
        font-size: 1rem;
    }

    .btn-secondary {
        background: transparent;
        border: 1px solid rgba(59, 130, 246, 0.4);
        color: #60A5FA;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-primary {
        background: #CCC9DC;
        border: none;
        color: #0C1821;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .file-upload {
        border: 2px dashed rgba(59, 130, 246, 0.4);
        border-radius: 8px;
        padding: 2rem;
        text-align: center;
        background: rgba(15, 23, 42, 0.5);
    }

    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .toast {
        min-width: 300px;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        background: rgba(30, 41, 59, 0.95);
        border: 1px solid rgba(148, 163, 184, 0.2);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        animation: slideInRight 0.3s ease-out;
    }

    .toast.success {
        border-color: rgba(34, 197, 94, 0.4);
        background: rgba(22, 163, 74, 0.15);
    }

    .toast.info {
        border-color: rgba(59, 130, 246, 0.4);
        background: rgba(37, 99, 235, 0.15);
    }

    .toast-icon {
        font-size: 1.25rem;
    }

    .toast-message {
        flex: 1;
        color: white;
        font-size: 0.9rem;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* Preview Modal Styles */
    .preview-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease-out;
    }

    .preview-modal-content {
        width: 95%;
        height: 95%;
        max-width: 1600px;
        background: white;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .preview-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: white;
    }

    .preview-modal-header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-family: 'Arial', sans-serif;
    }

    .btn-close-modal {
        background: transparent;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 8px;
        transition: background 0.2s;
    }

    .btn-close-modal:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .preview-modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
        background: #f5f5f5;
    }

    .preview-frame-container {
        background: white;
        min-height: 100%;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .preview-modal-footer {
        padding: 1rem 1.5rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    .btn-download-pdf {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-download-pdf:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

<PageTitle>Customize PDF</PageTitle>

<div style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <div
        style="padding: 2rem; background: linear-gradient(135deg, rgba(50, 74, 95, 0.4) 0%, rgba(12, 24, 33, 0.4) 100%); border-radius: 16px; margin-bottom: 2rem;">
        <h1 style="font-size: 1.875rem; font-weight: 700; color: white; margin: 0 0 0.5rem 0;">Personnaliser le Rapport
            PDF</h1>
            <p style="color: #94A3B8; margin: 0;">Téléchargez le logo et choisissez les couleurs</p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
            <!-- Left Panel -->
            <div class="card-bg">
                <h2 style="font-size: 1.1rem; font-weight: 700; color: white; margin-bottom: 1.5rem;">Paramètres</h2>

                <!-- Company Name -->
                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-size: 0.875rem; color: #94A3B8; margin-bottom: 0.5rem;">Nom de
                        l'entreprise</label>
                        <input type="text" @bind="companyName" class="input-field" placeholder="Votre Entreprise" />
                    </div>

                    <!-- Logo -->
                    <div style="margin-bottom: 1.5rem;">
                        <label style="display: block; font-size: 0.875rem; color: #94A3B8; margin-bottom: 0.5rem;">Logo</label>
                        <div class="file-upload">
                            <button @onclick="async () => await BrowseFileAsync()"
                                    style="background: transparent; border: none; color: #60A5FA; cursor: pointer; font-size: 1rem;">
                                Sélectionner le Logo
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(uploadedFileName))
                        {
                            <span style="font-size: 0.75rem; color: #22C55E; margin-top: 0.5rem; display: block;">Téléchargé:
                                @uploadedFileName</span>
                            }
                        </div>

                        <!-- Colors -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                            <div>
                                <label style="display: block; font-size: 0.875rem; color: #94A3B8; margin-bottom: 0.5rem;">Couleur
                                    Principale</label>
                                    <input type="color" @bind="primaryColor"
                                           style="width: 100%; height: 2.5rem; border: none; border-radius: 8px; cursor: pointer;" />
                                </div>
                                <div>
                                    <label style="display: block; font-size: 0.875rem; color: #94A3B8; margin-bottom: 0.5rem;">Couleur
                                        Secondaire</label>
                                        <input type="color" @bind="secondaryColor"
                                               style="width: 100%; height: 2.5rem; border: none; border-radius: 8px; cursor: pointer;" />
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                                    <button @onclick="GoToEventDetails" class="btn-secondary">Voir les détails de l'événement</button>
                                    <button @onclick="ExportPdf" class="btn-primary" disabled="@isGenerating">
                                        @if (isGenerating)
                                        {
                                            <span style="display: flex; align-items: center; gap: 0.5rem;">
                                                <span class="spinner"
                                                      style="width: 16px; height: 16px; border: 2px solid rgba(0,0,0,0.3); border-top-color: #0C1821; border-radius: 50%; animation: spin 0.8s linear infinite;"></span>
                                                Génération...
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Générer</span>
                                        }
                                    </button>
                                </div>
                            </div>

                            <!-- Right Panel - Preview -->
                            @* <div class="card-bg">
                            <h2 style="font-size: 1.1rem; font-weight: 700; color: white; margin-bottom: 1.5rem;">Aperçu du PDF</h2>
                            <div
                                style="background: white; padding: 2rem; border-radius: 8px; color: #0C1821; min-height: 400px; display: flex;
        flex-direction: column; justify-content: flex-start;">
                                @if (!string.IsNullOrEmpty(companyName))
                                {
                                    <div style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem; color: #0C1821;">@companyName
                                    </div>
                                }
                                <div style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; color: @primaryColor;">
                                    @(currentEvent?.Name ?? "Rapport d'Événement")
                                </div>
                                <div style="font-size: 0.875rem; color: #64748B; line-height: 1.6;">
                                    <p><strong>Date:</strong> @currentEvent?.Date.ToLocalTime().ToString("yyyy-MM-dd")</p>
                                    <p><strong>Viewers:</strong> @(currentEvent?.ViewerCount.ToString() ?? "N/A")</p>
                                    <p><strong>Durée:</strong> @FormatDuration(currentEvent?.StreamDuration)</p>
                                </div>
                            </div>
                        </div> *@
                        </div>
                    </div>

                    <!-- Toast Notifications -->
                    @if (toasts.Any())
                    {
                        <div class="toast-container">
                            @foreach (var toast in toasts)
                            {
                                <div class="toast @toast.Type">
                                    <span class="toast-icon">@toast.Icon</span>
                                    <span class="toast-message">@toast.Message</span>
                                </div>
                            }
                        </div>
                    }

                    <!-- Preview Modal -->
                    @if (showPreviewModal)
                    {
                        <div class="preview-modal-backdrop" @onclick="ClosePreviewModal">
                            <div class="preview-modal-content" @onclick:stopPropagation>
                                <div class="preview-modal-header">
                                    <h2>Aperçu du Rapport</h2>
                                    <button class="btn-close-modal" @onclick="ClosePreviewModal">✕</button>
                                </div>
                                <div class="preview-modal-body">
                                    @if (!string.IsNullOrEmpty(generatedHtml))
                                    {
                                        <div class="preview-frame-container">
                                            @((MarkupString)ExtractBodyContent(generatedHtml))
                                        </div>
                                    }
                                </div>
                                <div class="preview-modal-footer">
                                    <button class="btn-download-pdf" @onclick="DownloadAsPdf">
                                        <span>📥</span> Télécharger en PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

@code {
    [Parameter]
    public string? Slug { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Event? currentEvent;
    private string companyName = string.Empty;
    private string primaryColor = string.Empty;
    private string secondaryColor = string.Empty;
    private string? uploadedFileName;
    private bool isGenerating = false;
    private bool showPreviewModal = false;
    private string generatedHtml = string.Empty;
    private List<ToastMessage> toasts = new();

    private class ToastMessage
    {
        public string Message { get; set; } = string.Empty;
        public string Type { get; set; } = "info";
        public string Icon { get; set; } = "ℹ️";
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Slug))
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.TryGetUserId(out var userId))
        {
            Navigation.NavigateTo("/login?message=sessionExpired");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        context.SetCurrentUser(userId);
        currentEvent = await context.Events
            .Include(item => item.Media)
            .FirstOrDefaultAsync(item => item.Slug == Slug);

        if (currentEvent is null)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        companyName = ReportOptions.Value.DefaultCompanyName;
        primaryColor = ReportOptions.Value.PrimaryColor;
        secondaryColor = ReportOptions.Value.SecondaryColor;
    }

    private string FormatDuration(TimeSpan? duration) =>
        duration == null ? "N/A" : $"{(int)duration.Value.TotalHours}h {duration.Value.Minutes}m";

    private async Task BrowseFileAsync()
    {
        uploadedFileName = "sample-logo.png";
        await Task.CompletedTask;
    }

    private void GoToEventDetails()
    {
        if (OnClose.HasDelegate)
        {
            OnClose.InvokeAsync();
            // Parent will open EventDetails modal
        }
        else
        {
            Navigation.NavigateTo($"/event/{Slug}");
        }
    }

    private async Task ExportPdf()
    {
        if (isGenerating) return;
        if (currentEvent == null) return;

        isGenerating = true;
        StateHasChanged();

        try
        {
            if (!await EnsureStorytellingAsync())
                return;

            var options = new PdfCustomizationOptions(
                CompanyName: companyName,
                LogoUrl: uploadedFileName ?? string.Empty,
                PrimaryColor: primaryColor,
                SecondaryColor: secondaryColor
            );

            AddToast("Génération du PDF en cours...", "info", "📄");
            StateHasChanged();

            var result = await PdfGenerationService.GeneratePdfAsync(currentEvent, options);

            if (result.Success && result.PdfBytes != null)
            {
                AddToast("PDF généré avec succès !", "success", "🎉");
                var fileName = $"Rapport_{currentEvent.Name.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd}.pdf";
                var pdfBase64 = Convert.ToBase64String(result.PdfBytes);
                await JS.InvokeVoidAsync("downloadFile", fileName, "application/pdf", pdfBase64);
            }
            else
            {
                AddToast($"Erreur: {result.ErrorMessage}", "info", "⚠️");
            }
        }
        catch (Exception ex)
        {
            AddToast($"Erreur: {ex.Message}", "info", "⚠️");
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task<bool> EnsureStorytellingAsync()
    {
        if (currentEvent is null)
            return false;

        await using var analyticsContext = await AnalyticsDbFactory.CreateDbContextAsync();
        var analysis = await analyticsContext.StorytellingAnalyses
            .FirstOrDefaultAsync(item => item.EventId == currentEvent.Id);
        if (analysis is not null)
            return true;

        AddToast("Analyse storytelling en cours...", "info", "📝");
        var response = await StorytellingService.GenerateStorytellingAsync(currentEvent.Slug);
        if (!response.Success || response.Data is null)
        {
            AddToast($"Analyse impossible : {response.ErrorMessage}", "info", "⚠️");
            return false;
        }

        analysis = new()
        {
            EventId = currentEvent.Id,
            ResponseJson = System.Text.Json.JsonSerializer.Serialize(response.Data),
            GeneratedAt = DateTime.UtcNow,
        };
        analyticsContext.StorytellingAnalyses.Add(analysis);
        await analyticsContext.SaveChangesAsync();
        return true;
    }

    private void AddToast(string message, string type = "info", string icon = "ℹ️")
    {
        toasts.Add(new ToastMessage
        {
            Message = message,
            Type = type,
            Icon = icon
        });
    }

    private void ClosePreviewModal()
    {
        showPreviewModal = false;
        generatedHtml = string.Empty;
        StateHasChanged();
    }

    private async Task DownloadAsPdf()
    {
        if (string.IsNullOrEmpty(generatedHtml)) return;

        var pdfBytes = System.Text.Encoding.UTF8.GetBytes(generatedHtml);
        var fileName = $"Rapport_{currentEvent?.Name.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd}.html";
        var pdfBase64 = Convert.ToBase64String(pdfBytes);
        await JS.InvokeVoidAsync("downloadFile", fileName, "text/html", pdfBase64);

        AddToast("Téléchargement lancé !", "success", "✅");
    }

    private string ExtractBodyContent(string fullHtml)
    {
        // Extract just the body content from the full HTML
        var startIndex = fullHtml.IndexOf("<body>", StringComparison.OrdinalIgnoreCase);
        var endIndex = fullHtml.IndexOf("</body>", StringComparison.OrdinalIgnoreCase);

        if (startIndex >= 0 && endIndex > startIndex)
        {
            return fullHtml.Substring(startIndex + 6, endIndex - startIndex - 6);
        }

        return fullHtml;
    }
}
