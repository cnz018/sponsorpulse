@page "/settings"
@rendermode RenderMode.InteractiveServer
@using SponsorPulse.Application.Services
@using SponsorPulse.Application.Common.Models
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Application.Common.Extensions
@using SponsorPulse.Application.Common.Interfaces
@using SponsorPulse.Infrastructure.Api.Extensions
@using SponsorPulse.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore

@inject IDemoDataService DemoDataService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ITwitchAuthStateService TwitchAuthStateService
@inject IConfiguration Configuration
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory


<PageTitle>Paramètres - SponsorPulse</PageTitle>

<div class="settings-page fade-in">
    <div class="settings-header mb-8">
        <h1 class="text-2xl font-bold text-white">Paramètres</h1>
        <p class="text-grey-text mt-2">Configurez les informations de votre organisation</p>
    </div>

    <div class="settings-grid">
        <!-- Section: Informations Organisation -->
        <div class="settings-section glass-panel">
            <div class="section-header">
                <div class="section-icon">🏢</div>
                <h2 class="section-title">Informations de l'organisation</h2>
            </div>

            <div class="section-content">
                <div class="form-group">
                    <label class="form-label">Nom de l'organisation</label>
                    <LumexTextbox Behavior="@InputBehavior.OnInput" @bind-Value="@organizationName"
                                  Placeholder="Ex: HyperCore Gaming" Class="w-full" Size="@Size.Medium" />
                </div>

                <div class="form-group">
                    <label class="form-label">Logo de l'organisation</label>
                    <div class="logo-upload-area">
                        @if (!string.IsNullOrEmpty(logoPreview))
                        {
                            <div class="logo-preview">
                                <img src="@logoPreview" alt="Logo preview" class="logo-image" />
                                <button class="remove-logo" @onclick="RemoveLogo" title="Supprimer le logo">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2">
                                        <path d="M18 6L6 18M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="upload-placeholder">
                                <div class="upload-icon">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.5">
                                        <path
                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <p class="upload-text">Fonctionnalité disponible en production</p>
                                <p class="upload-hint">PNG, JPG jusqu'à 2MB</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Configuration Twitter Analytics -->
        <div class="settings-section glass-panel">
            <div class="section-header">
                <div class="section-icon">📊</div>
                <h2 class="section-title">Twitter Analytics</h2>
            </div>

            <div class="section-content">
                <div class="form-group">
                    <label class="form-label">
                        Ad Value Equivalent (AVE) par défaut
                        <span class="label-hint">Valeur utilisée pour la démonstration</span>
                    </label>
                    <div class="input-with-prefix">
                        <span class="prefix">€</span>
                        <input type="text" @bind="@defaultAveValueString" class="form-input" placeholder="5000" />
                    </div>
                    <p class="form-help">
                        L'AVE représente la valeur publicitaire équivalente de votre exposition médiatique.
                        Valeur actuelle : <strong class="text-lavender">@defaultAveValue.ToString("N0") €</strong>
                    </p>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Multiplicateur Viral
                        <span class="label-hint">Coefficient pour le calcul de portée</span>
                    </label>
                    <input type="text" @bind="@viralMultiplierString" class="form-input" placeholder="1.5" step="0.1" />
                    <p class="form-help">
                        Facteur multiplicateur basé sur le ratio retweets/tweets.
                        Actuel : <strong class="text-lavender">@viralMultiplier.ToString("F2")x</strong>
                    </p>
                </div>
            </div>
        </div>

        
        <!-- Section: Twitch Integration -->
        <div class="settings-section glass-panel">
            <div class="section-header">
                <div class="section-icon">🎮</div>
                <h2 class="section-title">Twitch</h2>
            </div>
            <div class="section-content">
                <p class="form-help">Connectez votre compte Twitch pour accéder aux analytiques</p>

                <div class="form-group">
                    <LumexButton class="btn-primary" @onclick="ConnectTwitch">Associer un compte Twitch</LumexButton>
                </div>

                <div class="form-group">
                    <div class="flex items-center justify-between">
                        <label class="form-label">Comptes connectés</label>
                        <div class="flex items-center gap-2">
                            <button class="btn-secondary" @onclick="LoadTwitchAccounts">Rafraîchir</button>
                        </div>
                    </div>

                    @if (twitchAccounts == null)
                    {
                        <p>Chargement...</p>
                    }
                    else if (!twitchAccounts.Any())
                    {
                        <p>Aucun compte connecté.</p>
                    }
                    else
                    {
                        <div class="connected-list mt-3">
                            @foreach (var acct in twitchAccounts)
                            {
                                <div
                                    class="connected-item flex items-center justify-between p-3 border rounded mb-2 bg-gray-900/20">
                                    <div class="flex items-center gap-3">
                                        <div>
                                            <div class="text-white font-semibold">@(acct.PlatformUsername)</div>
                                            <div class="text-gray-400 text-xs">@("@" + acct.PlatformUserId)</div>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2">
                                        <!-- Statut automatique informatif -->
                                        <span
                                            class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded border border-emerald-500/20 font-medium">
                                            ● Synchronisation Active
                                        </span>

                                        @if (acct.TokenExpiresAt.HasValue)
                                        {
                                            <div class="text-gray-400 text-xs">Exp: @acct.TokenExpiresAt.Value.ToString("g")</div>
                                        }

                                        <LumexButton class="btn-danger" Size="@Size.Small"
                                                     @onclick="() => ShowDisconnectConfirm(acct.PlatformUserId, acct.PlatformUsername)">
                                            Déconnecter
                                        </LumexButton>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (showDisconnectConfirm)
                    {
                        <div class="fixed inset-0 flex items-center justify-center bg-black/60 z-50">
                            <div class="bg-gray-800 p-6 rounded shadow-lg w-96">
                                <h3 class="text-lg font-bold text-white mb-2">Déconnecter le compte</h3>
                                <p class="text-gray-300 mb-4">Voulez-vous vraiment déconnecter <strong>@(confirmDisplayName
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ?? confirmTwitchUserId)</strong> ?</p>
                                    <div class="flex justify-end gap-2">
                                        <button class="btn-secondary" @onclick="CancelDisconnect"
                                                disabled="@isDisconnecting">Annuler</button>
                                        <button class="btn-danger" @onclick="ConfirmDisconnect"
                                                disabled="@isDisconnecting">@((isDisconnecting) ? "Suppression…" :
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "Confirmer")</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>


                    <!-- Section: Couleurs de Marque -->
                    <div class="settings-section glass-panel">
                        <div class="section-header">
                            <div class="section-icon">🎨</div>
                            <h2 class="section-title">Couleurs de marque</h2>
                        </div>

                        <div class="section-content">
                            <div class="color-picker-group">
                                <div class="color-picker-item">
                                    <label class="form-label">Couleur Primaire</label>
                                    <div class="color-picker-wrapper">
                                        <input type="color" @bind="primaryColor" class="color-picker" />
                                        <div class="color-value-display">
                                            <span class="color-preview" style="background: @primaryColor"></span>
                                            <span class="color-hex">@primaryColor</span>
                                        </div>
                                    </div>
                                    <div class="color-presets">
                                        <span class="preset-label">Prédéfinies :</span>
                                        <button class="preset-color" style="background: #CCC9DC"
                                                @onclick="@(() => SetPrimary("#CCC9DC"))" title="Lavender"></button>
                                        <button class="preset-color" style="background: #6366F1"
                                                @onclick="@(() => SetPrimary("#6366F1"))" title="Indigo"></button>
                                        <button class="preset-color" style="background: #8B5CF6"
                                                @onclick="@(() => SetPrimary("#8B5CF6"))" title="Purple"></button>
                                        <button class="preset-color" style="background: #EC4899"
                                                @onclick="@(() => SetPrimary("#EC4899"))" title="Pink"></button>
                                        <button class="preset-color" style="background: #10B981"
                                                @onclick="@(() => SetPrimary("#10B981"))" title="Emerald"></button>
                                        <button class="preset-color" style="background: #3B82F6"
                                                @onclick="@(() => SetPrimary("#3B82F6"))" title="Blue"></button>
                                    </div>
                                </div>

                                <div class="color-picker-item">
                                    <label class="form-label">Couleur Secondaire</label>
                                    <div class="color-picker-wrapper">
                                        <input type="color" @bind="secondaryColor" class="color-picker" />
                                        <div class="color-value-display">
                                            <span class="color-preview" style="background: @secondaryColor"></span>
                                            <span class="color-hex">@secondaryColor</span>
                                        </div>
                                    </div>
                                    <div class="color-presets">
                                        <span class="preset-label">Prédéfinies :</span>
                                        <button class="preset-color" style="background: #94A3B8"
                                                @onclick="@(() => SetSecondary("#94A3B8"))" title="Slate"></button>
                                        <button class="preset-color" style="background: #64748B"
                                                @onclick="@(() => SetSecondary("#64748B"))" title="Gray"></button>
                                        <button class="preset-color" style="background: #475569"
                                                @onclick="@(() => SetSecondary("#475569"))" title="Charcoal"></button>
                                        <button class="preset-color" style="background: #14B8A6"
                                                @onclick="@(() => SetSecondary("#14B8A6"))" title="Teal"></button>
                                        <button class="preset-color" style="background: #F59E0B"
                                                @onclick="@(() => SetSecondary("#F59E0B"))" title="Amber"></button>
                                        <button class="preset-color" style="background: #EF4444"
                                                @onclick="@(() => SetSecondary("#EF4444"))" title="Red"></button>
                                    </div>
                                </div>
                            </div>

                            <!-- Preview des couleurs -->
                            <div class="color-preview-section">
                                <label class="form-label">Aperçu</label>
                                <div class="color-preview-cards">
                                    <div class="preview-card primary"
                                         style="background: linear-gradient(135deg, @primaryColor 0%, @primaryColor 100%)">
                                        <span class="preview-label">Primaire</span>
                                    </div>
                                    <div class="preview-card secondary"
                                         style="background: linear-gradient(135deg, @secondaryColor 0%, @secondaryColor 100%)">
                                        <span class="preview-label">Secondaire</span>
                                    </div>
                                    <div class="preview-card combined"
                                         style="background: linear-gradient(135deg, @primaryColor 0%, @secondaryColor 100%)">
                                        <span class="preview-label">Combiné</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="settings-actions">
                        <LumexButton Variant="@Variant.Light" Size="@Size.Medium" Color="@ThemeColor.Default"
                                     OnClick="ResetToDefaults">
                            <span class="button-icon">↺</span> Réinitialiser
                        </LumexButton>
                        <div class="actions-spacer"></div>
                        <LumexButton Variant="@Variant.Solid" Color="@ThemeColor.Success" Size="@Size.Medium"
                                     OnClick="SaveSettings">
                            <span class="button-icon">✓</span> Enregistrer les modifications
                        </LumexButton>
                    </div>
                </div>

                <!-- Toast Notifications -->
                @if (showToast)
                {
                    <div class="toast-container @toastType">
                        <div class="toast-icon">@toastIcon</div>
                        <div class="toast-message">@toastMessage</div>
                    </div>
                }
            </div>
        </div>
        <style>
            .settings-page {
                padding: 2rem;
                max-width: 1200px;
                margin: 0 auto;
                animation: fadeIn 0.5s ease-out;
            }

            .settings-header {
                margin-bottom: 2rem;
            }

            .settings-header h1 {
                font-size: 1.875rem;
                font-weight: 700;
                color: var(--white);
                margin: 0;
            }

            .settings-grid {
                display: grid;
                gap: 1.5rem;
            }

            .settings-section {
                background: rgba(30, 41, 59, 0.4);
                border: 1px solid rgba(148, 163, 184, 0.2);
                border-radius: 16px;
                overflow: hidden;
            }

            .section-header {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 1.25rem 1.5rem;
                background: rgba(15, 23, 42, 0.5);
                border-bottom: 1px solid rgba(148, 163, 184, 0.1);
            }

            .section-icon {
                font-size: 1.5rem;
            }

            .section-title {
                font-size: 1.125rem;
                font-weight: 600;
                color: var(--white);
                margin: 0;
            }

            .section-content {
                padding: 1.5rem;
            }

            .form-group {
                margin-bottom: 1.5rem;
            }

            .form-group:last-child {
                margin-bottom: 0;
            }

            .form-label {
                display: block;
                font-size: 0.875rem;
                font-weight: 500;
                color: var(--grey-text);
                margin-bottom: 0.5rem;
            }

            .label-hint {
                display: block;
                font-size: 0.75rem;
                color: var(--grey-muted);
                margin-top: 0.25rem;
                font-weight: 400;
            }

            .form-help {
                font-size: 0.8rem;
                color: var(--grey-text);
                margin-top: 0.5rem;
                line-height: 1.5;
            }

            .text-lavender {
                color: var(--lavender);
            }

            .form-input {
                width: 100%;
                padding: 0.75rem 1rem;
                padding-left: 2.5rem;
                border: 1px solid rgba(148, 163, 184, 0.3);
                border-radius: 8px;
                background: rgba(15, 23, 42, 0.5);
                color: white;
                font-size: 1rem;
            }

            /* Logo Upload */
            .logo-upload-area {
                border: 2px dashed rgba(59, 130, 246, 0.3);
                border-radius: 12px;
                padding: 2rem;
                text-align: center;
                background: rgba(15, 23, 42, 0.4);
            }

            .upload-placeholder {
                cursor: pointer;
            }

            .upload-icon {
                color: var(--grey-text);
                margin-bottom: 1rem;
                opacity: 0.7;
            }

            .upload-text {
                color: var(--white);
                font-weight: 500;
                margin: 0.5rem 0;
            }

            .upload-hint {
                color: var(--grey-text);
                font-size: 0.8rem;
                margin: 0;
            }

            .logo-preview {
                position: relative;
                display: inline-block;
            }

            .logo-image {
                max-width: 200px;
                max-height: 150px;
                border-radius: 8px;
                object-fit: contain;
                background: rgba(0, 0, 0, 0.3);
                padding: 0.5rem;
            }

            .remove-logo {
                position: absolute;
                top: -8px;
                right: -8px;
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: #EF4444;
                border: none;
                color: white;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s;
            }

            .remove-logo:hover {
                background: #DC2626;
                transform: scale(1.1);
            }

            /* Input with prefix */
            .input-with-prefix {
                position: relative;
                display: flex;
                align-items: center;
            }

            .prefix {
                position: absolute;
                left: 1rem;
                color: var(--grey-text);
                font-weight: 500;
                pointer-events: none;
            }

            /* Color Picker */
            .color-picker-group {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 1.5rem;
                margin-bottom: 1.5rem;
            }

            .color-picker-item {
                padding: 1rem;
                background: rgba(15, 23, 42, 0.3);
                border-radius: 12px;
                border: 1px solid rgba(148, 163, 184, 0.1);
            }

            .color-picker-wrapper {
                display: flex;
                align-items: center;
                gap: 1rem;
                margin-top: 0.75rem;
            }

            .color-picker {
                width: 50px;
                height: 50px;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                background: none;
                padding: 0;
            }

            .color-picker::-webkit-color-swatch-wrapper {
                padding: 0;
            }

            .color-picker::-webkit-color-swatch {
                border: 2px solid rgba(148, 163, 184, 0.3);
                border-radius: 8px;
            }

            .color-picker::-moz-color-swatch {
                border: 2px solid rgba(148, 163, 184, 0.3);
                border-radius: 8px;
            }

            .color-value-display {
                flex: 1;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.5rem 0.75rem;
                background: rgba(30, 41, 59, 0.5);
                border-radius: 8px;
                border: 1px solid rgba(148, 163, 184, 0.2);
            }

            .color-preview {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                border: 1px solid rgba(255, 255, 255, 0.2);
            }

            .color-hex {
                font-family: 'Courier New', monospace;
                font-size: 0.875rem;
                color: var(--lavender);
                text-transform: uppercase;
            }

            .color-presets {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-top: 1rem;
                flex-wrap: wrap;
            }

            .preset-label {
                font-size: 0.75rem;
                color: var(--grey-text);
                margin-right: 0.25rem;
            }

            .preset-color {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                border: 2px solid transparent;
                cursor: pointer;
                transition: all 0.2s;
            }

            .preset-color:hover {
                transform: scale(1.15);
                border-color: rgba(255, 255, 255, 0.3);
            }

            /* Color Preview Cards */
            .color-preview-section {
                margin-top: 1.5rem;
            }

            .color-preview-cards {
                display: flex;
                gap: 1rem;
                margin-top: 0.75rem;
            }

            .preview-card {
                flex: 1;
                height: 80px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

            .preview-label {
                color: white;
                font-size: 0.75rem;
                font-weight: 600;
                text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
            }

            .preview-card.combined {
                flex: 2;
            }

            /* Actions */
            .settings-actions {
                display: flex;
                align-items: center;
                gap: 1rem;
                padding: 1.5rem;
                background: rgba(15, 23, 42, 0.5);
                border-radius: 12px;
                border: 1px solid rgba(148, 163, 184, 0.1);
            }

            .actions-spacer {
                flex: 1;
            }

            .button-icon {
                margin-right: 0.5rem;
            }

            /* Toast */
            .toast-container {
                position: fixed;
                bottom: 2rem;
                right: 2rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 1rem 1.25rem;
                border-radius: 12px;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
                animation: slideInRight 0.3s ease-out;
                z-index: 9999;
            }

            .toast-container.success {
                background: rgba(22, 163, 74, 0.15);
                border: 1px solid rgba(34, 197, 94, 0.4);
            }

            .toast-container.info {
                background: rgba(37, 99, 235, 0.15);
                border: 1px solid rgba(59, 130, 246, 0.4);
            }

            .toast-icon {
                font-size: 1.25rem;
            }

            .toast-message {
                color: white;
                font-size: 0.9rem;
            }

            @@keyframes slideInRight {
                from {
                    transform: translateX(100%);
                    opacity: 0;
                }

                to {
                    transform: translateX(0);
                    opacity: 1;
                }
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            /* Responsive */
            @@media (max-width: 768px) {
                .settings-page {
                    padding: 1rem;
                }

                .color-picker-group {
                    grid-template-columns: 1fr;
                }

                .color-preview-cards {
                    flex-direction: column;
                }

                .settings-actions {
                    flex-direction: column;
                }

                .actions-spacer {
                    display: none;
                }
            }
        </style>

@code {
    // Organisation
    private string organizationName = "HyperCore Gaming";
    private string? logoBase64;
    private string? logoPreview;

    // Twitter Analytics
    private decimal defaultAveValue = 12500m;
    private string defaultAveValueString = "12500";
    private double viralMultiplier = 1.84;
    private string viralMultiplierString = "1.84";

    // Couleurs
    private string primaryColor = "#CCC9DC";
    private string secondaryColor = "#475569";

    // Toast
    private bool showToast;
    private string toastType = "success";
    private string toastIcon = "✓";
    private string toastMessage = "";

    [SupplyParameterFromQuery(Name = "platform")]
    public string? Platform { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? PlatformStatus { get; set; }

    private Guid? CurrentUserId;


    protected override async Task OnInitializedAsync()
    {
        // Charger les paramètres existants depuis DemoDataService
        var settings = await DemoDataService.GetDemoSettingsAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity is null || !authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login?message=session_expired", true);
        }

        authState.TryGetUserId(out var userId);
        CurrentUserId = userId;


        if (settings is not null)
        {
            organizationName = settings.OrganizationName ?? "HyperCore Gaming";
            logoBase64 = settings.LogoBase64;
            logoPreview = settings.LogoBase64;
            defaultAveValue = settings.DefaultAveValue;
            defaultAveValueString = settings.DefaultAveValue.ToString();
            viralMultiplier = settings.ViralMultiplier;
            viralMultiplierString = settings.ViralMultiplier.ToString();
            primaryColor = settings.PrimaryColor ?? "#CCC9DC";
            secondaryColor = settings.SecondaryColor ?? "#475569";
        }
        await LoadTwitchAccounts();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadTwitchAccounts();
    }

    private void RemoveLogo()
    {
        logoBase64 = null;
        logoPreview = null;
        ShowToast("Logo supprimé", "info");
    }

    private async Task SaveSettings()
    {
        try
        {
            // Parse values
            if (decimal.TryParse(defaultAveValueString, out var aveValue))
            {
                defaultAveValue = aveValue;
            }

            if (double.TryParse(viralMultiplierString, out var multiplier))
            {
                viralMultiplier = multiplier;
            }

            var settings = new DemoSettings
            {
                OrganizationName = organizationName,
                LogoBase64 = logoBase64,
                DefaultAveValue = defaultAveValue,
                ViralMultiplier = viralMultiplier,
                PrimaryColor = primaryColor,
                SecondaryColor = secondaryColor
            };

            await DemoDataService.SaveDemoSettingsAsync(settings);
            ShowToast("Paramètres enregistrés avec succès", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"Erreur lors de l'enregistrement: {ex.Message}", "error");
        }
    }

    private void ResetToDefaults()
    {
        organizationName = "HyperCore Gaming";
        logoBase64 = null;
        logoPreview = null;
        defaultAveValue = 12500m;
        defaultAveValueString = "12500";
        viralMultiplier = 1.84;
        viralMultiplierString = "1.84";
        primaryColor = "#CCC9DC";
        secondaryColor = "#475569";
        ShowToast("Paramètres réinitialisés", "info");
    }

    // Twitch management
    private List<LinkedAccount> twitchAccounts = [];

    private record TwitchAccount(string TwitchUserId, string? DisplayName, string? Login, string? ProfileImageUrl,
string? Scopes, DateTimeOffset? ExpiresAt);

    private bool showDisconnectConfirm = false;
    private string? confirmTwitchUserId;
    private string? confirmDisplayName;
    private bool isDisconnecting = false;

    private async Task LoadTwitchAccounts()
    {
        try
        {
            using var dbContext = await DbFactory.CreateDbContextAsync();
            dbContext.CurrentUserId = CurrentUserId;

            twitchAccounts = await dbContext.LinkedAccounts
                .AsNoTracking()
                .Where(t => t.Platform == PlatformType.Twitch)
                .ToListAsync();
        }
        catch
        {
            twitchAccounts = [];
        }

        @* StateHasChanged(); *@
    }

    private async Task ConnectTwitch()
    {
        TwitchAuthHandler? twitchHandler = new();
        var url = await twitchHandler.LoginAsync(TwitchAuthStateService, Configuration);

        Navigation.NavigateTo(url, false);
    }

    private void ShowDisconnectConfirm(string twitchUserId, string? displayName)
    {
        confirmTwitchUserId = twitchUserId;
        confirmDisplayName = displayName;
        showDisconnectConfirm = true;
    }

    private void CancelDisconnect()
    {
        showDisconnectConfirm = false;
        confirmTwitchUserId = null;
        confirmDisplayName = null;
    }

    private async Task ConfirmDisconnect()
    {
        if (string.IsNullOrEmpty(confirmTwitchUserId)) return;
        isDisconnecting = true;
        try
        {
            var twitchHandler = new TwitchAuthHandler();
            var resp = await twitchHandler.RevokeTokenAsync(confirmTwitchUserId, Configuration, DbFactory);

            if (resp.IsSuccessStatusCode)
            {
                ShowToast("Compte Twitch déconnecté", "success");
                await LoadTwitchAccounts();
            }
            else
            {
                ShowToast("Impossible de supprimer le compte Twitch", "error");
            }
        }
        catch (Exception ex)
        {
            ShowToast("Erreur réseau: " + ex.Message, "error");
        }
        finally
        {
            isDisconnecting = false;
            showDisconnectConfirm = false;
            confirmTwitchUserId = null;
            confirmDisplayName = null;
        }
    }

    private void SetPrimary(string color)
    {
        primaryColor = color;
    }

    private void SetSecondary(string color)
    {
        secondaryColor = color;
    }

    private void ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
        toastIcon = type switch
        {
            "success" => "✓",
            "error" => "✕",
            "info" => "ℹ",
            _ => "✓"
        };
        showToast = true;

        _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => showToast = false));
    }
}
