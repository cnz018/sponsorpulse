@using SponsorPulse.Domain.Models

@code {
    [Parameter]
    public required ReportModel Model { get; set; } = new ReportModel();
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>PULSE DYNAMIC HUD - @Model.CompanyName</title>
    <style>
            /* --- DYNAMIQUE ET RADICAL : PULSE HUD SYSTEM --- */
            :root {
                --primary:
                    @Model.PrimaryColor
                ;
                --secondary:
                    @Model.SecondaryColor
                ;
                --glass: rgba(15, 23, 42, 0.8);
                --border: rgba(255, 255, 255, 0.1);
                --text-neon: #E2E8F0;
                --bg-deep: #020617;
            }

            @@page {
                size: A4;
                margin: 0;
            }

            body {
                margin: 0;
                padding: 0;
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-deep);
                color: var(--text-neon);
                letter-spacing: -0.02em;
            }

            .mono {
                font-family: 'JetBrains Mono', monospace;
                font-variant-numeric: tabular-nums;
            }

            .page {
                position: relative;
                width: 210mm;
                height: 297mm;
                page-break-after: always;
                overflow: hidden;
                background: radial-gradient(circle at 50% 50%, #1e1b4b 0%, #020617 100%);
            }

            /* --- BACKGROUND DYNAMICS --- */
            .grid-bg {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image:
                    linear-gradient(var(--border) 1px, transparent 1px),
                    linear-gradient(90deg, var(--border) 1px, transparent 1px);
                background-size: 40px 40px;
                mask-image: radial-gradient(circle at center, black, transparent 80%);
                opacity: 0.3;
            }

            /* --- PAGE 1: THE CORE (COVER) --- */
            .core-container {
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                text-align: center;
            }

            .pulse-circle {
                position: relative;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                border: 1px solid var(--primary);
                display: flex;
                justify-content: center;
                align-items: center;
                box-shadow: 0 0 50px rgba(0, 0, 0, 0.5), inset 0 0 30px var(--primary);
            }

            .pulse-circle::before {
                content: '';
                position: absolute;
                width: 110%;
                height: 110%;
                border: 1px dashed var(--secondary);
                border-radius: 50%;
                animation: rotate 20s linear infinite;
            }

            .hero-img-mask {
                width: 320px;
                height: 320px;
                border-radius: 50%;
                overflow: hidden;
                border: 4px solid var(--text-neon);
            }

            .hero-img-mask img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                filter: saturate(1.5) contrast(1.1);
            }

            .title-glitch {
                margin-top: 50px;
                font-size: 4rem;
                font-weight: 900;
                text-transform: uppercase;
                background: linear-gradient(to bottom, #fff 40%, var(--primary));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            /* --- WIDGETS LAYOUT --- */
            .hud-grid {
                display: grid;
                grid-template-columns: repeat(6, 1fr);
                grid-template-rows: repeat(8, 1fr);
                gap: 15px;
                height: 100%;
                padding: 30px;
            }

            .widget {
                background: var(--glass);
                border: 1px solid var(--border);
                border-top: 3px solid var(--primary);
                padding: 20px;
                position: relative;
                backdrop-filter: blur(10px);
            }

            .widget-label {
                font-size: 0.65rem;
                text-transform: uppercase;
                color: var(--primary);
                font-weight: bold;
                letter-spacing: 2px;
                margin-bottom: 10px;
                display: block;
            }

            .big-number {
                font-size: 3.5rem;
                font-weight: 800;
                line-height: 1;
                color: #fff;
            }

            /* --- PAGE 2: DATA FLOW --- */
            .chart-flow {
                position: absolute;
                bottom: 50px;
                left: 50px;
                right: 50px;
                height: 300px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: flex-end;
                gap: 5px;
            }

            .bar-flow {
                flex: 1;
                background: linear-gradient(to top, var(--primary), var(--secondary));
                opacity: 0.8;
                border-radius: 2px 2px 0 0;
            }

            /* --- PAGE 3: MODULAR STORY --- */
            .module-text {
                border-left: 2px solid var(--secondary);
                padding-left: 30px;
                margin-bottom: 40px;
            }

            .module-text h3 {
                font-size: 0.8rem;
                background: var(--secondary);
                display: inline-block;
                padding: 2px 10px;
                color: black;
                margin-bottom: 15px;
            }

            /* --- PAGE 4: MOSAÏQUE HEXAGONALE (SIMULÉE) --- */
            .hex-gallery {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                justify-content: center;
            }

            .hex-item {
                width: 180px;
                height: 180px;
                clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
                background: var(--surface);
            }

            .hex-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            @@keyframes rotate {
                from {
                    transform: rotate(0deg);
                }

                to {
                    transform: rotate(360deg);
                }
            }
    </style>
</head>
<body>

    <!-- PAGE 1: CORE HUD -->
    <div class="page">
        <div class="grid-bg"></div>

        <div class="core-container">
            <div class="pulse-circle">
                <div class="hero-img-mask">
                    @if (Model.PhotoUrls.Any())
                    {
                        <img src="@Model.PhotoUrls.First()" />
                    }
                    else
                    {
                        <div style="width:100%; height:100%; background: var(--primary);"></div>
                    }
                </div>

                <!-- Data tags circulaires -->
                <div
                    style="position: absolute; top: -20px; left: 50%; transform: translateX(-50%); background: var(--bg-deep); padding: 5px 15px; border: 1px solid var(--primary); font-size: 0.7rem; color: var(--primary);">
                    LIVE_STATUS: COMPLETED</div>
                </div>

                <h1 class="title-glitch">@Model.EventName</h1>
                <div style="font-size: 1.5rem; letter-spacing: 10px; opacity: 0.7;">IMPACT REPORT @Model.EventDate.Year
                </div>
                <div style="margin-top: 60px; display: flex; gap: 40px; align-items: center;">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" style="height: 60px; filter: grayscale(1) brightness(2);" />
                    }
                    <div style="width: 2px; height: 40px; background: var(--border);"></div>
                    <div style="text-align: left;">
                        <div style="font-size: 0.7rem; color: var(--secondary);">CLIENT_ID</div>
                        <div style="font-weight: bold; font-size: 1.2rem;">@Model.CompanyName.ToUpper()</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PAGE 2: METRICS HUD -->
        <div class="page">
            <div class="grid-bg"></div>
            <div class="hud-grid">
                <!-- Header Widget -->
                <div class="widget"
                     style="grid-column: span 6; display: flex; justify-content: space-between; align-items: center; border-top-color: var(--secondary);">
                    <div>
                        <span class="widget-label">Stream Analytics</span>
                        <h2 style="margin:0; font-size: 1.5rem;">@Model.EventPlatform.ToUpper() NODE_01</h2>
                    </div>
                    <div class="mono" style="color: var(--secondary);">REC_STABLE // 100%</div>
                </div>

                @if (Model.TwitchMetrics != null)
                {
                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">Peak Concurrent Viewers</span>
                        <div class="big-number mono">@Model.TwitchMetrics.PeakViewers.ToString("N0")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> SIGNAL_MAX_REACH</div>
                    </div>

                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">Unique Viewers</span>
                        <div class="big-number mono">@Model.TwitchMetrics.UniqueViewers.ToString("N0")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> TOTAL_REACH</div>
                    </div>

                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">Viewer Hours</span>
                        <div class="big-number mono">@Model.TwitchMetrics.ViewerHours.ToString("N0")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> WATCH_TIME_INDEX</div>
                    </div>

                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">Engagement Rate</span>
                        <div class="big-number mono">@Model.TwitchMetrics.EngagementRate.ToString("P0")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> AUDIENCE_ACTIVE</div>
                    </div>

                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">Estimated ROI</span>
                        <div class="big-number mono" style="color: var(--primary);">@Model.TwitchMetrics.EstimatedROI.ToString("C0")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> RETURN_VALUE</div>
                    </div>

                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">CPM</span>
                        <div class="big-number mono">@Model.TwitchMetrics.CPM.ToString("C2")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> COST_EFFICIENCY</div>
                    </div>
                }

                @if (Model.TwitchMetrics != null && Model.TwitchMetrics.Sponsor.MentionCount > 0)
                {
                    <div class="widget" style="grid-column: span 6; grid-row: span 2; border-top-color: var(--secondary);">
                        <span class="widget-label">Sponsor Exposure Matrix</span>
                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 15px;">
                            <div>
                                <div style="font-size: 0.65rem; color: var(--text-muted);">MENTIONS</div>
                                <div style="font-size: 1.8rem; font-weight: 800; color: var(--primary);">@Model.TwitchMetrics.Sponsor.MentionCount</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; color: var(--text-muted);">EXPOSURE TIME</div>
                                <div style="font-size: 1.8rem; font-weight: 800;">@Model.TwitchMetrics.Sponsor.TotalExposureTime.ToString("hh\\:mm")</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; color: var(--text-muted);">LOGO IMPRESSIONS</div>
                                <div style="font-size: 1.8rem; font-weight: 800;">@Model.TwitchMetrics.Sponsor.LogoImpressions.ToString("N0")</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; color: var(--text-muted);">BRAND SENTIMENT</div>
                                <div style="font-size: 1.8rem; font-weight: 800; color: var(--secondary);">@Model.TwitchMetrics.Sponsor.BrandSentimentScore.ToString("P0")</div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.TwitchMetrics != null && Model.TwitchMetrics.Chat.TotalMessages > 0)
                {
                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">Chat Messages</span>
                        <div class="big-number mono">@Model.TwitchMetrics.Chat.TotalMessages.ToString("N0")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> TOTAL_ACTIVITY</div>
                    </div>

                    <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                        <span class="widget-label">Unique Chatters</span>
                        <div class="big-number mono">@Model.TwitchMetrics.Chat.UniqueChatters.ToString("N0")</div>
                        <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> ACTIVE_USERS</div>
                    </div>
                }

                        <!-- Graph Area -->
                        <div class="widget" style="grid-column: span 6; grid-row: span 3; background: rgba(0,0,0,0.4);">
                            <span class="widget-label">Live Viewership Timeline</span>
                            <div style="height: 150px; display: flex; align-items: flex-end; gap: 4px; padding-bottom: 20px;">
                                @for (int i = 0; i < 30; i++)
                                {
                                    var h = new Random().Next(20, 100);
                                    <div style="flex: 1; height: @(h)%; background: var(--primary); opacity: @(0.3 + (i*0.02));"></div>
                                }
                            </div>
                            <div style="display: flex; justify-content: space-between; font-size: 0.6rem; opacity: 0.5;">
                                <span>T-0h</span>
                                <span>T-4h (PEAK)</span>
                                <span>T-8h (END)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PAGE 3: TWITTER ANALYTICS -->
                <div class="page" style="padding: 60px;">
                    <div class="grid-bg"></div>
                    <h2
                        style="font-size: 3rem; font-weight: 900; margin-bottom: 60px; border-bottom: 1px solid var(--secondary); padding-bottom: 20px;">
                        SOCIAL_<span style="color: var(--secondary);">IMPACT</span>
                    </h2>

                    @if (Model.TwitterAnalytics != null)
                    {
                        <div class="hud-grid" style="grid-template-rows: repeat(6, 1fr);">
                            <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                                <span class="widget-label">Unique Reach</span>
                                <div class="big-number mono">@Model.TwitterAnalytics.UniqueReach.ToString("N0")</div>
                                <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> ESTIMATED_AUDIENCE</div>
                            </div>

                            <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                                <span class="widget-label">Engagement Rate</span>
                                <div class="big-number mono">@Model.TwitterAnalytics.EngagementRate.ToString("P0")</div>
                                <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> PERFORMANCE_INDEX</div>
                            </div>

                            <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                                <span class="widget-label">Total Impressions</span>
                                <div class="big-number mono">@Model.TwitterAnalytics.EstimatedImpressions.ToString("N0")</div>
                                <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> TOTAL_VIEWS</div>
                            </div>

                            <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                                <span class="widget-label">Ad Value Equivalent</span>
                                <div class="big-number mono" style="color: var(--secondary);">@Model.TwitterAnalytics.AdValueEquivalent.ToString("C0")</div>
                                <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> MEDIA_VALUE</div>
                            </div>

                            <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                                <span class="widget-label">Estimated ROI</span>
                                <div class="big-number mono" style="color: var(--primary);">@Model.TwitterAnalytics.EstimatedROI.ToString("C0")</div>
                                <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> RETURN_METRIC</div>
                            </div>

                            <div class="widget" style="grid-column: span 3; grid-row: span 2;">
                                <span class="widget-label">Share of Voice</span>
                                <div class="big-number mono">@Model.TwitterAnalytics.ShareOfVoice.ToString("P0")</div>
                                <div style="margin-top: 20px; font-size: 0.8rem; color: var(--secondary);">>>> CONVERSATION_DOMINANCE</div>
                            </div>
                        </div>

                        @if (Model.TwitterAnalytics.TopHashtags.Any())
                        {
                            <div style="margin-top: 40px; border: 1px solid var(--secondary); padding: 30px; background: rgba(0,0,0,0.3);">
                                <div style="font-size: 0.7rem; color: var(--secondary); letter-spacing: 3px; margin-bottom: 20px;">/// TRENDING_HASHTAGS</div>
                                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
                                    @foreach (var hashtag in Model.TwitterAnalytics.TopHashtags.Take(3))
                                    {
                                        <div style="background: rgba(255,255,255,0.03); padding: 20px; border: 1px solid rgba(255,255,255,0.05);">
                                            <div style="font-size: 1.2rem; font-weight: bold; color: var(--primary); margin-bottom: 10px;">#@hashtag.Tag</div>
                                            <div style="font-size: 0.65rem; color: var(--text-muted);">
                                                <div>@hashtag.UsageCount.ToString("N0") USES</div>
                                                <div style="margin-top: 5px;">@hashtag.TotalEngagements.ToString("N0") ENGAGEMENTS</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.TwitterAnalytics.TopInfluencer.FollowersCount > 0)
                        {
                            <div style="margin-top: 40px; border: 1px solid var(--primary); padding: 30px; background: rgba(99, 102, 241, 0.05);">
                                <div style="font-size: 0.7rem; color: var(--primary); letter-spacing: 3px; margin-bottom: 20px;">/// TOP_INFLUENCER</div>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <div style="font-size: 1.5rem; font-weight: bold;">@Model.TwitterAnalytics.TopInfluencer.Name</div>
                                        <div style="color: var(--secondary); font-size: 1rem;">@@@Model.TwitterAnalytics.TopInfluencer.Handle</div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 2rem; font-weight: 800; color: var(--primary);">@Model.TwitterAnalytics.TopInfluencer.FollowersCount.ToString("N0")</div>
                                        <div style="font-size: 0.65rem; color: var(--text-muted);">FOLLOWERS</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- PAGE 3: ANALYTICS MODULAR -->
                <div class="page" style="padding: 60px;">
                    <div class="grid-bg"></div>
                    <h2
                        style="font-size: 3rem; font-weight: 900; margin-bottom: 60px; border-bottom: 1px solid var(--primary); padding-bottom: 20px;">
                        INSIGHTS_<span style="color: var(--primary);">STORY</span>
                    </h2>

                    <div class="module-text">
                        <h3>NARRATIVE_PATH</h3>
                        <p style="font-size: 1.2rem; line-height: 1.6; color: #cbd5e1;">@Model.StorytellingText</p>
                    </div>

                    <div class="module-text">
                        <h3>STRATEGIC_EVALUATION</h3>
                        <p style="font-size: 1.2rem; line-height: 1.6; color: #cbd5e1;">@Model.AnalysisText</p>
                    </div>

                    <!-- Call to action stylisé -->
                    <div
                        style="margin-top: 100px; border: 1px dashed var(--secondary); padding: 30px; display: flex; align-items: center; gap: 20px;">
                        <div style="width: 50px; height: 50px; background: var(--secondary); border-radius: 50%;"></div>
                        <div>
                            <div style="font-weight: bold; color: var(--secondary);">PULSE_ACTION_REQUIRED</div>
                            <div style="font-size: 0.9rem; opacity: 0.7;">Consultez les opportunités manquées en page 05</div>
                        </div>
                    </div>
                </div>

                <!-- PAGE 4: HEX-GALLERY -->
                <div class="page" style="padding: 60px;">
                    <div class="grid-bg"></div>
                    <h2 style="font-size: 3rem; font-weight: 900; margin-bottom: 60px; text-align: right;">CAPTURE_<span
                        style="color: var(--secondary);">DATA</span></h2>

                        <div class="hex-gallery">
                            @foreach (var url in Model.PhotoUrls.Take(6))
                            {
                                <div class="hex-item">
                                    <img src="@url" />
                                </div>
                            }
                        </div>

                        <div style="margin-top: 80px; text-align: center;">
                            <div
                                style="display: inline-block; padding: 10px 30px; border: 1px solid var(--primary); color: var(--primary); font-size: 0.8rem; letter-spacing: 5px;">
                                VISUAL_LOG_END
                            </div>
                        </div>
                    </div>

                    <!-- PAGE 5: FUTURE_STEPS -->
                    <div class="page" style="padding: 60px;">
                        <div class="grid-bg"></div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; height: 100%;">
                            <div style="border: 1px solid rgba(225, 29, 72, 0.3); background: rgba(225, 29, 72, 0.05); padding: 40px;">
                                <h3 style="color: #fb7185; margin-top: 0; font-size: 0.8rem; letter-spacing: 3px;">CRITICAL_MISSES</h3>
                                <ul style="list-style: none; padding: 0; margin-top: 30px;">
                                    @foreach (var item in Model.OpportunitiesMissed)
                                    {
                                        <li                    style="margin-bottom: 20px; border-left: 2px solid #fb7185; padding-left: 15px; font-size: 0.95rem;">
                                            @item</li>
                                        }
                                    </ul>
                                </div>

                                <div style="border: 1px solid var(--primary); background: rgba(99, 102, 241, 0.05); padding: 40px;">
                                    <h3 style="color: var(--primary); margin-top: 0; font-size: 0.8rem; letter-spacing: 3px;">
                                        GROWTH_SUGGESTIONS</h3>
                                        <ul style="list-style: none; padding: 0; margin-top: 30px;">
                                            @foreach (var item in Model.Suggestions)
                                            {
                                                <li style="margin-bottom: 20px; border-left: 2px solid var(--primary); padding-left: 15px; font-size: 0.95rem;">
                                                    @item</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>

                                    <div
                                        style="position: absolute; bottom: 40px; width: calc(100% - 120px); display: flex; justify-content: space-between; font-size: 0.6rem; opacity: 0.5; font-family: monospace;">
                                        <span>SYS_ID: @Guid.NewGuid().ToString().Substring(0,8).ToUpper()</span>
                                        <span>DATE: @Model.ReportDate.ToString("yyyy.MM.dd")</span>
                                        <span>SPONSOR_PULSE_OS_V4.0</span>
                                    </div>
                                </div>

                            </body>

                        </html>