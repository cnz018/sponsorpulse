@using SponsorPulse.Application.Common.Interfaces
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Domain.Models
@using SponsorPulse.Domain.Enums
@using SponsorPulse.Infrastructure.Persistence
@using SponsorPulse.Infrastructure.Repositories
@using SponsorPulse.Infrastructure.Xpoz.Strategies
@using Microsoft.EntityFrameworkCore

@inject IXpozPlatformStrategy TwitterStrategy
@inject ISocialPostRepository PostRepository
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory

<div class="twitter-fetcher-section">
    <div class="fetch-controls mb-4 flex gap-3">
        <button class="btn-fetch @(_isFetching ? "loading" : "")" @onclick="FetchTwitterData" disabled="@_isFetching">
            <span class="spinner-icon" style="display: @(_isFetching ? "inline" : "none")">⟳</span>
            @(_isFetching ? "Récupération en cours..." : "Récupérer les données")
        </button>
        <button class="btn-ghost text-sm" @onclick="ToggleManualEdit">
            @(_showManualEdit ? "✓ Terminer" : "✎ Éditer manuellement")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-banner mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-red-400 text-sm">
            <span class="icon-error">⚠</span> @_errorMessage
            <button class="ml-2 text-red-300 hover:text-red-200" @onclick="() => _errorMessage = null">✕</button>
        </div>
    }

    @if (_showManualEdit)
    {
        <div class="manual-edit-section glass-panel p-4 mb-4 border border-blue-500/20">
            <h4 class="text-sm font-semibold text-lavender mb-3">Édition manuelle des données</h4>

            <div class="form-group mb-3">
                <label class="form-label text-xs">Volume de tweets</label>
                <input type="number" class="sp-input" @bind="_manualData.TotalTweets" min="0" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label text-xs">Engagement total</label>
                <input type="number" class="sp-input" @bind="_manualData.TotalEngagement" min="0" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label text-xs">Impressions estimées</label>
                <input type="number" class="sp-input" @bind="_manualData.EstimatedImpressions" min="0" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label text-xs">Valeur publicitaire (€)</label>
                <input type="number" class="sp-input" @bind="_manualData.AdValueEquivalent" min="0" step="0.01" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label text-xs">Sentiment positif (%)</label>
                <input type="number" class="sp-input" @bind="_manualSentimentPositive" min="0" max="100" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label text-xs">Sentiment neutre (%)</label>
                <input type="number" class="sp-input" @bind="_manualSentimentNeutral" min="0" max="100" />
            </div>

            <div class="form-group mb-4">
                <label class="form-label text-xs">Multiplicateur viral</label>
                <input type="number" class="sp-input" @bind="_manualData.ViralMultiplier" min="0" step="0.1" />
            </div>

            <button class="btn-primary-sp w-full text-sm" @onclick="SaveManualData">
                Enregistrer les modifications
            </button>
        </div>
    }

    @if (_twitterAnalytics != null)
    {
        <!-- Grille des métriques clés -->
        <div class="twitter-metrics grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="metric-card">
                <div class="metric-label">Tweets</div>
                <div class="metric-value">@_twitterAnalytics.TotalTweets</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Portée (Reach)</div>
                <div class="metric-value">@(_twitterAnalytics.EstimatedImpressions >= 1_000_000
                                                                                                                                                                                ? $"{(_twitterAnalytics.EstimatedImpressions / 1_000_000.0):F1}M"
                                                                                                                                                                                : _twitterAnalytics.EstimatedImpressions.ToString("N0"))</div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">Taux d'Engagement</div>
                    <div class="metric-value text-blue-400">@_twitterAnalytics.EngagementRate.ToString("F2")%</div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">Valeur EMV (€)</div>
                    <div class="metric-value text-accent-gold">@_twitterAnalytics.AdValueEquivalent.ToString("C0")</div>
                </div>
            </div>

            <!-- Section détails des métriques et sentiment -->
            <div class="twitter-details grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <div class="detail-section glass-panel overflow-y-hidden p-3">
                    <h4 class="text-xs font-semibold text-lavender mb-2 uppercase tracking-wider">Langues des
                        posts</h4>
                        <div class="sentiment-bars">
                            @if (_twitterAnalytics.LanguageRatio != null && _twitterAnalytics.LanguageRatio.Any())
                            {
                                @foreach (var (language, percentage) in _twitterAnalytics.LanguageRatio)
                                {
                                    <div class="sentiment-item mb-2">
                                        <div class="flex justify-between mb-1">
                                            <span class="text-xs text-gray-300">@language</span>
                                            <span class="text-xs font-semibold text-blue-400">@percentage%</span>
                                        </div>
                                        <div class="progress-bar">
                                            <div class="progress-fill bg-blue-500" style="width: @percentage%"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-gray-500 italic">Aucune donnée de langue disponible.</p>
                            }
                        </div>
                    </div>

                    <div class="detail-section glass-panel p-3">
                        <h4 class="text-xs font-semibold text-lavender mb-2 uppercase tracking-wider">Indicateurs avancés</h4>
                        <div class="metrics-list text-sm">
                            <div class="metric-row mb-2">
                                <span class="text-gray-400">Interactions totales</span>
                                <span class="font-semibold text-blue-300">@_twitterAnalytics.TotalEngagement.ToString("N0")</span>
                            </div>
                            <div class="metric-row mb-2">
                                <span class="text-gray-400">Score de Viralité</span>
                                <span class="font-semibold text-orange-400">@_twitterAnalytics.ViralMultiplier.ToString("F2")</span>
                            </div>

                            @if (_twitterAnalytics.TopInfluencer != null &&
                                                    !string.IsNullOrEmpty(_twitterAnalytics.TopInfluencer.Name))
                            {
                                <div class="metric-row">
                                    <span class="text-gray-400">Top Influencer</span>
                                    <span class="font-semibold text-blue-400">
                                        @_twitterAnalytics.TopInfluencer.Name (@(_twitterAnalytics.TopInfluencer.FollowersCount /
                                        1000)K)
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>


                @if (_twitterAnalytics.TopTweets.Any())
                {
                    <div class="top-tweets mt-4">
                        <h4 class="text-xs font-semibold text-lavender mb-2 uppercase tracking-wider">Top Tweets</h4>
                        <div class="space-y-2">
                            @foreach (var tweet in _twitterAnalytics.TopTweets.Take(3))
                            {
                                <div class="tweet-card glass-panel p-3 border border-blue-500/10">
                                    <div class="flex items-start gap-2">
                                        <div class="flex-1">
                                            <p class="text-xs font-semibold text-blue-300">@tweet.AuthorName</p>
                                            <p class="text-xs text-gray-400">@tweet.AuthorHandle</p>
                                            <p class="text-sm text-gray-200 mt-1 line-clamp-2">@tweet.Text</p>
                                        </div>
                                        <div class="flex gap-2 text-xs">
                                            <span class="px-2 py-1 bg-red-500/10 text-red-400 rounded">❤ @tweet.Likes</span>
                                            <span class="px-2 py-1 bg-green-500/10 text-green-400 rounded">🔄 @tweet.Retweets</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
    else if (!_isFetching && _twitterAnalytics == null && string.IsNullOrEmpty(_errorMessage))
            {
                <div class="empty-state p-8 text-center text-gray-400">
                    <p class="text-sm">Cliquez sur "Récupérer les données" pour importer les analytics Twitter via Xpoz</p>
                </div>
            }
        </div>

        <style>
