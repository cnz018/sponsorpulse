@code {
    [Parameter]
    public Event? EventToUpdate { get; set; }

    [Parameter]
    public EventCallback<Event> OnDataUpdated { get; set; }

    private const string TWITTER_DATA_LANG_KEY = "Language";
    private const string UNKWNON_LANG = "Inconnu";
    private TwitterAnalytics? _twitterAnalytics;
    private bool _isFetching;
    private string? _errorMessage;
    private bool _showManualEdit;

    private TwitterAnalyticsManualInput _manualData = new();
    private double _manualSentimentPositive;
    private double _manualSentimentNeutral;

    private class TwitterAnalyticsManualInput
    {
        public int TotalTweets { get; set; }
        public int TotalEngagement { get; set; }
        public long EstimatedImpressions { get; set; }
        public decimal AdValueEquivalent { get; set; }
        public double ViralMultiplier { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (EventToUpdate != null)
        {
            // 1. Charger d'abord les posts enregistrés dans SQLite (social_analytics.db)
            var storedEntities = await PostRepository.GetPostsByEventIdAsync(EventToUpdate.Id);

            if (storedEntities.Any())
            {
                _twitterAnalytics = MapPostsToAnalytics(storedEntities, storedEntities.Count);
            }
            else if (EventToUpdate.TwitterAnalytics != null)
            {
                _twitterAnalytics = EventToUpdate.TwitterAnalytics;
            }

            //InitializeManualEditData();
        }
    }

    private async Task FetchTwitterData()
    {
        if (EventToUpdate == null || string.IsNullOrWhiteSpace(EventToUpdate.TwitterHashtags))
        {
            _errorMessage = "Veuillez d'abord ajouter des hashtags Twitter pour cet événement.";
            return;
        }

        _isFetching = true;
        _errorMessage = null;

        try
        {
            if (await PostRepository.HasAlreadyPosts(EventToUpdate.Id))
            {
                await PostRepository.DeleteOldPostByEventId(EventToUpdate.Id);
            }

            var startDate = EventToUpdate.SocialStartDate ?? DateTime.UtcNow.AddDays(-7);
            var endDate = EventToUpdate.SocialEndDate ?? DateTime.UtcNow;

            // 2. Appel à la stratégie Xpoz
            var result = await TwitterStrategy.FetchAndFormatDataAsync(
                EventToUpdate.TwitterHashtags,
                startDate,
                endDate
            );

            if (!result.IsSuccess)
            {
                _errorMessage = result.ErrorMessage ?? "Erreur lors de la récupération des données depuis Xpoz.";
                return;
            }

            var fetchedPosts = result.Value.Posts;

            // 3. Assigner l'EventId à chaque post pour la relation logique
            foreach (SocialPost post in fetchedPosts)
            {
                post.EventId = EventToUpdate.Id;
            }

            // 4. Stocker les posts + le JSON brut dans 'social_analytics.db'
            await PostRepository.SavePostsAsync(fetchedPosts);

            // 5. Calculer le modèle d'affichage UI à partir des posts
            _twitterAnalytics = MapPostsToAnalytics(fetchedPosts, result.Value.TotalCount);

            // 6. Mettre à jour l'événement parent
            EventToUpdate = EventToUpdate with { TwitterAnalytics = _twitterAnalytics };

            InitializeManualEditData();
            await OnDataUpdated.InvokeAsync(EventToUpdate);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur lors de la récupération : {ex.Message}";
        }
        finally
        {
            _isFetching = false;
        }
    }

    /// <summary>
    /// Convertit la liste des posts du domaine vers le modèle d'affichage UI
    /// </summary>
    /// <summary>
    /// Convertit la liste des posts du domaine vers le modèle d'affichage UI en appliquant les formules standards.
    /// </summary>
    private TwitterAnalytics MapPostsToAnalytics(List<SocialPost> posts, int totalCount)
    {
        if (posts is null || !posts.Any())
        {
            return new TwitterAnalytics();
        }

        // 1. Extraction des données brutes cumulées
        long totalImpressions = posts.Sum(p => p.ImpressionsCount);
        int totalLikes = posts.Sum(p => p.LikesCount);
        int totalRetweets = posts.Sum(p => p.SharesCount);
        int totalReplies = posts.Sum(p => p.CommentsCount);

        // Interactions totales (L + RT + R)
        int totalEngagement = totalLikes + totalRetweets + totalReplies;

        // 2. Calcul de l'EMV (Earned Media Value) / AVE
        // Standards du marché : CPM = 8.00 € / 1000 impressions, CPE = 0.50 € par interaction
        const decimal cpmStandard = 8.00m;
        const decimal cpeStandard = 0.50m;

        decimal emvImpressions = ((decimal)totalImpressions / 1000m) * cpmStandard;
        decimal emvEngagement = totalEngagement * cpeStandard;
        decimal earnedMediaValue = emvImpressions + emvEngagement;

        // 3. Calcul du Taux d'Engagement (%)
        double engagementRate = totalImpressions > 0
            ? ((double)totalEngagement / totalImpressions) * 100.0
            : 0.0;

        // 4. Calcul du Score de Viralité (VR)
        // VR = (RT + Quotes) / max(1, L)
        double viralMultiplier = (double)totalRetweets / Math.Max(1, totalLikes);

        // 5. Identification du Top Influencer
        var topAuthor = posts.OrderByDescending(p => p.AuthorFollowersCount).FirstOrDefault();
        TopInfluencer? topInfluencer = topAuthor != null ? new TopInfluencer
        {
            Name = topAuthor.AuthorName,
            Handle = topAuthor.AuthorHandle,
            FollowersCount = topAuthor.AuthorFollowersCount
        } : null;

        // 6. Mapping des Top Tweets avec leur propre taux d'engagement
        var topTweets = posts
            .OrderByDescending(p => p.LikesCount + p.SharesCount + p.CommentsCount)
            .Take(5)
            .Select(p =>
            {
                int tweetEngagement = p.LikesCount + p.SharesCount + p.CommentsCount;
                double tweetEr = p.ImpressionsCount > 0
                    ? ((double)tweetEngagement / p.ImpressionsCount) * 100.0
                    : 0.0;

                return new TopTweet
                {
                    Id = p.Id,
                    AuthorName = p.AuthorName,
                    AuthorHandle = p.AuthorHandle,
                    Text = p.ContentText,
                    Likes = p.LikesCount,
                    Retweets = p.SharesCount,
                    Replies = p.CommentsCount,
                    Impressions = p.ImpressionsCount,
                    EngagementRate = tweetEr,
                    CreatedAt = p.CreatedAt
                };
            }).ToList();

        var totalPosts = posts.Count;
        var languageRatio = posts
            .Select(p =>
            {
                // Récupère la langue depuis PlatformSpecificData ou "und" si non disponible
                if (p.PlatformSpecificData != null &&
                    p.PlatformSpecificData.TryGetValue(TWITTER_DATA_LANG_KEY, out var val))
                {
                    return val.ToString();
                }
                return UNKWNON_LANG;
            })
            .GroupBy(GetLanguageDisplayName)
            .ToDictionary(
                g => g.Key,
                g => Math.Round(((double)g.Count() / totalPosts) * 100.0, 1)
            )
            .OrderByDescending(kv => kv.Value)
            .ToDictionary(kv => kv.Key, kv => kv.Value);

        // 7. Assemblage du modèle analytics final
        return new TwitterAnalytics
        {
            TotalTweets = totalCount > 0 ? totalCount : posts.Count,
            TotalEngagement = totalEngagement,
            EstimatedImpressions = totalImpressions,
            UniqueReach = totalImpressions, // Reach = Impressions
            AdValueEquivalent = earnedMediaValue,
            EngagementRate = engagementRate,
            ViralMultiplier = viralMultiplier,
            CPM = cpmStandard,
            LanguageRatio = languageRatio,
            TopInfluencer = topInfluencer ?? new TopInfluencer(),
            TopTweets = topTweets
        };
    }

    /// <summary>
    /// Convertit les entités relues depuis SQLite vers le modèle d'affichage UI
    /// </summary>
    private TwitterAnalytics MapEntitiesToAnalytics(List<SocialPost> entities)
    {
        var domainPosts = entities.Select(e => new SocialPost
        {
            Id = e.Id,
            EventId = e.EventId,
            Platform = e.Platform,
            AuthorId = e.AuthorId,
            AuthorName = e.AuthorName,
            AuthorHandle = e.AuthorHandle,
            AuthorFollowersCount = e.AuthorFollowersCount,
            ContentText = e.ContentText,
            CreatedAt = e.CreatedAt,
            LikesCount = e.LikesCount,
            SharesCount = e.SharesCount,
            CommentsCount = e.CommentsCount,
            ImpressionsCount = e.ImpressionsCount,
            RawJsonPayload = e.RawJsonPayload
        }).ToList();

        return MapPostsToAnalytics(domainPosts, entities.Count);
    }

    private void ToggleManualEdit()
    {
        _showManualEdit = !_showManualEdit;
    }

    private void InitializeManualEditData()
    {
        if (_twitterAnalytics == null) return;

        _manualData.TotalTweets = _twitterAnalytics.TotalTweets;
        _manualData.TotalEngagement = _twitterAnalytics.TotalEngagement;
        _manualData.EstimatedImpressions = _twitterAnalytics.EstimatedImpressions;
        _manualData.AdValueEquivalent = _twitterAnalytics.AdValueEquivalent;
        _manualData.ViralMultiplier = _twitterAnalytics.ViralMultiplier;

        if (_twitterAnalytics.SentimentRatio.TryGetValue("Positif", out var positive))
            _manualSentimentPositive = positive;

        if (_twitterAnalytics.SentimentRatio.TryGetValue("Neutre", out var neutral))
            _manualSentimentNeutral = neutral;
    }

    private async Task SaveManualData()
    {
        if (_twitterAnalytics == null) return;

        var negativeRatio = 100 - _manualSentimentPositive - _manualSentimentNeutral;

        _twitterAnalytics = _twitterAnalytics with
        {
            TotalTweets = _manualData.TotalTweets,
            TotalEngagement = _manualData.TotalEngagement,
            EstimatedImpressions = _manualData.EstimatedImpressions,
            AdValueEquivalent = _manualData.AdValueEquivalent,
            ViralMultiplier = _manualData.ViralMultiplier,
            SentimentRatio = new Dictionary<string, double>
            {
                { "Positif", _manualSentimentPositive },
                { "Neutre", _manualSentimentNeutral },
                { "Négatif", Math.Max(0, negativeRatio) }
            }
        };

        if (EventToUpdate != null)
        {
            EventToUpdate = EventToUpdate with { TwitterAnalytics = _twitterAnalytics };
            await OnDataUpdated.InvokeAsync(EventToUpdate);
        }

        _showManualEdit = false;
    }

    /// <summary>
    /// Convertit un code de langue ISO (ex: 'fr', 'en') en nom complet d'affichage.
    /// </summary>
    private static string GetLanguageDisplayName(string code)
    {
        if (string.IsNullOrWhiteSpace(code)) return "Non défini";

        return code.ToLowerInvariant().Trim() switch
        {
            "fr" or "fre" or "fra" => "Français",
            "en" or "eng" => "Anglais",
            "es" or "spa" => "Espagnol",
            "de" or "ger" or "deu" => "Allemand",
            "it" or "ita" => "Italien",
            "pt" or "por" => "Portugais",
            "ja" or "jpn" => "Japonais",
            _ => code.ToUpperInvariant()
        };
    }
}