@using System.Text
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SponsorPulse.Application.Common.Interfaces
@using SponsorPulse.Application.Services
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Domain.Models
@using SponsorPulse.Domain.Models.Twitch
@using SponsorPulse.Domain.Primitives
@using SponsorPulse.Infrastructure.Persistence
@inject ITwitchService TwitchService
@inject ILogger<TwitchFetcher> Logger
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<SponsorPulseAnalyticsDbContext> AnalyticsDbFactory
@inject TwitchMetricCalculator MetricCalculator

<div class="twitch-fetcher mb-8">
    <div class="flex items-center gap-4 mb-4">
        <div class="flex-grow">
            <label class="block text-gray-400 text-xs uppercase font-bold mb-2">Broadcaster ID Twitch</label>
            <div class="tracking-status" aria-live="polite">@GetStatusLabel(EventToUpdate.Status)</div>
            <div class="flex gap-2">
                <input type="text" class="sp-input flex-grow" disabled value="@EventToUpdate.BroadcasterId" />

                <button class="btn-fetch" @onclick="FetchData" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <div class="spinner"></div>
                    }
                    else
                    {
                        <span>Collecter Données</span>
                    }
                </button>

                <button class="btn-fetch manual-toggle" @onclick="ToggleManualInput">
                    @(ShowManualInput ? "Masquer" : (EventToUpdate.Status == EventStatus.AnalysisReady ||
                    EventToUpdate.Status == EventStatus.Completed ? "Modifier" : "Manuel"))
                </button>
            </div>
        </div>
    </div>

    @if (ShowManualInput || !string.IsNullOrEmpty(ErrorMessage))
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="glass-alert error mb-4">
                <span class="icon">⚠️</span> @ErrorMessage
            </div>
        }

        <!-- Manual Fallback Mode -->
        <div class="glass-panel p-4 mt-2 border-orange-500/300">
            <h4 class="text-white text-sm font-bold mb-3">Saisie Manuelle</h4>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label block text-gray-400 text-xs uppercase font-bold mb-2">Spectateurs
                        Moyens</label>
                        <input type="number" class="sp-input" @bind="EventToUpdate.ViewerCount" />
                    </div>
                    <div>
                        <label class="form-label block text-gray-400 text-xs uppercase font-bold mb-2">Pic Spectateurs</label>
                        <input type="number" class="sp-input" @bind="EventToUpdate.PeakViewers" />
                    </div>
                    <div>
                        <label class="form-label block text-gray-400 text-xs uppercase font-bold mb-2">Durée (HH:mm)</label>
                        <input type="text" class="sp-input" @bind="StreamDurationString" placeholder="HH:mm" />
                    </div>
                    <div>
                        <label class="form-label block text-gray-400 text-xs uppercase font-bold mb-2">Date début</label>
                        <input type="datetime-local" class="sp-input" @bind="StartedAtLocal" />
                    </div>
                    <div class="col-span-2">
                        <label class="form-label block text-gray-400 text-xs uppercase font-bold mb-2">Jeu</label>
                        <input type="text" class="sp-input" @bind="EventToUpdate.GameName" />
                    </div>
                </div>
                <button
                class="btn-primary mt-4 w-full p-2 rounded bg-blue-600 text-white font-bold hover:bg-blue-700 transition"
                @onclick="SaveManualData">Sauvegarder Manuellement</button>
            </div>
        }

        @if (EventToUpdate.Status == EventStatus.Completed || EventToUpdate.Status == EventStatus.AnalysisReady)
        {
            <div class="glass-panel success p-4 mt-4 bg-green-900/20 border border-green-500/30 rounded-lg">
                <h4 class="text-green-400 text-sm font-bold mb-2">✅ Données Collectées</h4>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
                    <div>
                        <span class="text-gray-400 block text-xs">Jeu</span>
                        <span class="text-white font-mono">@EventToUpdate.GameName</span>
                    </div>
                    <div>
                        <span class="text-gray-400 block text-xs">Viewers</span>
                        <span class="text-white font-mono">@EventToUpdate.ViewerCount</span>
                    </div>
                    <div>
                        <span class="text-gray-400 block text-xs">Durée</span>
                        <span class="text-white font-mono">@(EventToUpdate.StreamDuration?.ToString(@"hh\:mm") ??
                                                                                                                                                                                                                                                                                                                                                                    "--:--")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .twitch-fetcher {
                background: rgba(0, 0, 0, 0.2);
                padding: 1.5rem;
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.05);
            }

            .sp-input {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.1);
                color: white;
                padding: 0.75rem;
                border-radius: 8px;
                width: 100%;
            }

            .btn-fetch {
                background: var(--accent-blue);
                color: white;
                border: none;
                padding: 0 1.5rem;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                min-width: 160px;
                height: 42px;
                transition: background 0.2s;
            }

            .btn-fetch:hover:not(:disabled) {
                background: #2563EB;
                /* Slightly lighter blue */
            }

            .btn-fetch:disabled {
                opacity: 0.7;
                cursor: wait;
                background: #1e3a8a;
            }

            .spinner {
                width: 20px;
                height: 20px;
                border: 2px solid rgba(255, 255, 255, 0.3);
                border-radius: 50%;
                border-top-color: white;
                animation: spin 1s ease-in-out infinite;
            }

            .manual-toggle {
                .tracking-status {
                    min-height: 1.25rem;
                    margin-bottom: 0.35rem;
                    color: #9CA3AF;
                    font-size: 0.75rem;
                }

                .manual-toggle {
                    margin-left: 0.5rem;
                    background: rgba(255, 255, 255, 0.1);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    min-width: 100px;
                }

                .manual-toggle:hover:not(:disabled) {
                    background: rgba(255, 255, 255, 0.2);
                }

                .glass-alert {
                    padding: 1rem;
                    border-radius: 8px;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .glass-alert.error {
                    background: rgba(239, 68, 68, 0.1);
                    border: 1px solid rgba(239, 68, 68, 0.2);
                    color: #FCA5A5;
                }

                @@keyframes spin {
                    to {
                        transform: rotate(360deg);
                    }
                }
        </style>

@code {
    [Parameter] public Event EventToUpdate { get; set; } = default!;
    [Parameter] public EventCallback<Event> OnDataUpdated { get; set; }
    [Parameter] public EventCallback<Event> OnStatusChanged { get; set; }

    private bool IsLoading = false;
    private bool ShowManualInput = false;
    private string? ErrorMessage;
    // Adresse locale par défaut de l'Azure Function
    private readonly string AzureFunctionBaseUrl = "http://localhost:7075/api";
    private Guid? _metricsCalculatedForEventId;

    private DateTime? StartedAtLocal
    {
        get => EventToUpdate.StartedAt.HasValue
            ? DateHelper.ToLocal(EventToUpdate.StartedAt.Value)
            : null;
        set => EventToUpdate.StartedAt = value.HasValue
            ? DateHelper.ToUtc(value.Value)
            : null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EventToUpdate.Status != EventStatus.Completed)
        {
            _metricsCalculatedForEventId = null;
            return;
        }

        if (_metricsCalculatedForEventId == EventToUpdate.Id)
        {
            return;
        }

        await using var analyticsDbContext = await AnalyticsDbFactory.CreateDbContextAsync();
        var snapshots = await analyticsDbContext
            .TwitchStreamSnapshots
            .AsNoTracking()
            .Where(snapshot => snapshot.EventId == EventToUpdate.Id)
            .ToListAsync();
        if (snapshots.Count == 0)
        {
            return;
        }

        var metrics = MetricCalculator.Calculate(snapshots);
        EventToUpdate.ViewerCount = metrics.ViewerCount;
        EventToUpdate.PeakViewers = metrics.PeakViewers;
        EventToUpdate.StreamDuration = metrics.StreamDuration;
        EventToUpdate.StartedAt = DateHelper.ToUtc(metrics.StartedAt.UtcDateTime);
        EventToUpdate.GameName = metrics.GameName;
        _metricsCalculatedForEventId = EventToUpdate.Id;
        await OnDataUpdated.InvokeAsync(EventToUpdate);
    }

    // Helper for binding TimeSpan to text input
    private string StreamDurationString
    {
        get => EventToUpdate.StreamDuration?.ToString(@"hh\:mm") ?? "";
        set
        {
            if (TimeSpan.TryParse(value, out var ts))
            {
                EventToUpdate.StreamDuration = ts;
            }
            else
            {
                // Optionally handle invalid input, or just don't set
            }
        }
    }

    private void ToggleManualInput()
    {
        ShowManualInput = !ShowManualInput;
        if (!ShowManualInput) ErrorMessage = null; // Clear error if hiding manual input
    }

    private static string GetStatusLabel(EventStatus status) =>
        status switch
        {
            EventStatus.Scheduled => "Planifié",
            EventStatus.Fetching => "Collecte en cours...",
            EventStatus.Live => "En direct",
            EventStatus.Completed => "Terminé",
            EventStatus.Error => "Erreur de collecte",
            _ => string.Empty,
        };

    private async Task FetchData()
    {
        IsLoading = true;
        ErrorMessage = null;
        var previousStatus = EventToUpdate.Status;

        try
        {
            await SetStatusAsync(EventStatus.Fetching);

            // Appel HTTP POST vers l'Azure Function pour déclencher la collecte et la sauvegarde
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirst("sub")?.Value
                ?? authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!Guid.TryParse(userId, out var currentUserId))
            {
                ErrorMessage = "Utilisateur non authentifié.";
                await SetStatusAsync(EventStatus.Error);
                return;
            }

            var requestBody = JsonSerializer.Serialize(new
            {
                broadcasterId = EventToUpdate.BroadcasterId,
                userId = currentUserId,
                eventId = EventToUpdate.Id,
            });
            var response = await Http.PostAsync(
                $"{AzureFunctionBaseUrl}/collect/twitch/",
                new StringContent(requestBody, Encoding.UTF8, "application/json")
            );

            if (response.IsSuccessStatusCode && response.Content != null)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
                {
                    ErrorMessage = "Aucun stream Twitch n'est actuellement en direct.";
                    await SetStatusAsync(previousStatus);
                    return;
                }

                var snapshot = await response.Content.ReadFromJsonAsync<TwitchStreamSnapshot>();
                if (snapshot is null || snapshot.EventId != EventToUpdate.Id)
                {
                    throw new InvalidOperationException("La Function a retourné un snapshot invalide.");
                }

                await SetStatusAsync(EventStatus.Live);
                await OnDataUpdated.InvokeAsync(EventToUpdate);
            }
            else
            {
                ErrorMessage = response.ReasonPhrase ?? "Erreur inconnue lors de l'appel Twitch.";

                await SetStatusAsync(EventStatus.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI Fetch Error");

            ErrorMessage = "Erreur technique: " + ex.Message;
            await SetStatusAsync(EventStatus.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveManualData()
    {
        // Simple manual save trigger
        await SetStatusAsync(EventStatus.AnalysisReady);
        // Hide manual input on save
        ShowManualInput = false;
        await OnDataUpdated.InvokeAsync(EventToUpdate);
        ErrorMessage = null; // Clear error on successful manual save
    }

    private async Task SetStatusAsync(EventStatus status)
    {
        if (EventToUpdate.Status == status)
        {
            return;
        }

        EventToUpdate.Status = status;
        await OnStatusChanged.InvokeAsync(EventToUpdate);
    }
}