@using SponsorPulse.Domain.Entities

<div
    style="background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 8px; padding: 1.5rem;">
    <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94A3B8;">@Label</span>
    <div style="font-size: 1.875rem; font-weight: 700; color: #CCC9DC; margin: 0.5rem 0;">@Value</div>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;
}